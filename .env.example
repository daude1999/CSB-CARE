# ── Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csb?schema=public
APP_URL=http://localhost:3000            # used in email links

# ── AI (optional). anthropic | simulated | none
# Default: simulated in development, none in production. Simulated output is always labelled.
AI_PROVIDER=simulated
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Private storage for evidence, service user documents, body map photos and raw source captures.
# local | database | supabase | azure. On Vercel, local is replaced by database (its disk does not keep files).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=csb-private
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...        # server only; never exposed to the browser
# SUPABASE_STORAGE_BUCKET=csb-private  # created private on first use

# ── Email. log | smtp   (log writes to the outbox table and the log only)
EMAIL_PROVIDER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=CSB <no-reply@example.com>

# ── Source monitoring
# SOURCE_USER_AGENT=CSBCare-Monitor/1.0 (+https://your-domain/contact)
# SOURCE_MIN_INTERVAL_MS=1500            # per-host politeness delay
# GOVUK_BASE_URL=https://www.gov.uk
# LEGISLATION_BASE_URL=https://www.legislation.gov.uk

# ── Worker
# WORKER_TICK_MS=60000
# WORKER_POLL_MS=5000

# ── Evidence malware scanning hook (optional; files are marked NOT_SCANNED without it)
# MALWARE_SCAN_URL=https://scanner.internal/scan
# EVIDENCE_REQUIRE_SCAN=false           # true holds files that have not been virus-checked until a scanner is set up

# ── Demo and misc
SEED_DEMO=true                            # set false for a clean production seed
# SHOW_DEMO_LOGINS=false                  # demo credentials on the sign-in page (never in production)
# COOKIE_SECURE=true                      # defaults to true in production
LOG_LEVEL=info
# Key for the encrypted service-user reference register (council, Frameworki, NHS numbers). Required in production;
# keep it separate from other secrets and never change it once real references are stored.
# CSB_REFERENCE_SECRET=
