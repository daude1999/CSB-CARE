// CSB data model.
// Design rules:
//  - Approved/published history is immutable (enforced by DB triggers in migration SQL).
//  - Every customer-owned row carries organisationId; server-side scoping is mandatory.
//  - Detection, substantive confirmation, applicability, revision need, approval and
//    implementation are separate records/stages.

generator client {
  provider        = "prisma-client-js"
  // queryCompiler + driverAdapters let PRISMA_CLIENT_ENGINE_TYPE=client run on the bundled WASM engine
  // (see prisma.config.ts). The default engine is unchanged.
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

enum PlatformRole {
  NONE
  PLATFORM_ADMIN // manages sources, jobs, master content
  CONTENT_EDITOR // authors master templates
  REGULATORY_REVIEWER // classifies regulatory changes, approves master templates
}

enum OrgRole {
  ORG_ADMIN
  POLICY_AUTHOR
  POLICY_REVIEWER
  POLICY_APPROVER
  COMPLIANCE_LEAD
  STAFF
  CARE_MANAGER
  CARE_COORDINATOR
  CARER
  FINANCE_OFFICER
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String?
  platformRoles PlatformRole[] @default([])
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  deactivatedAt DateTime?
  /// Set by an Evantix platform administrator ("Require a password reset"): the person cannot sign in until they use a
  /// one-time reset link, which clears it.
  passwordResetRequired Boolean @default(false)

  sessions         Session[]
  memberships      Membership[]
  notifications    Notification[]
  acknowledgements Acknowledgement[]
  trainingRecords  TrainingRecord[]
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  ip          String?
  userAgent   String?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // email or ip
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Shared request counters for rate limiting. Every server instance (Vercel functions included) counts in the same
/// row, so a limit holds however many instances are running. Rows older than an hour are cleared as they are written.
model RateLimitWindow {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Organisation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  jurisdiction String   @default("ENG")
  isDemo       Boolean  @default(false)
  settings     Json     @default("{}") // approval rules, escalation config
  createdAt    DateTime @default(now())

  branches              Branch[]
  memberships           Membership[]
  policies              Policy[]
  hrWorkspace           HrWorkspace?
  staff                 StaffMember[]
  readinessRequirements ReadinessRequirement[]
  policyAssignmentRules PolicyAssignmentRule[]
  serviceUsers          ServiceUser[]
  areas                 Area[]
  visits                Visit[]
  accountTokens         AccountToken[]
  /// Evantix Platform Admin Centre: the organisation as a SaaS customer (one row per organisation).
  customerAccount       CustomerAccount?
  subscriptions         CustomerSubscription[]
  moduleEntitlements    TenantModuleEntitlement[]
  supportAccessGrants   SupportAccessGrant[]
}

model ServiceType {
  code         String              @id // e.g. RESIDENTIAL, DOMICILIARY, SUPPORTED_LIVING
  name         String
  jurisdiction String              @default("ENG")
  branches     BranchServiceType[]
}

model Branch {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  cqcLocationId  String?
  createdAt      DateTime             @default(now())
  services       BranchServiceType[]
  memberships    Membership[]
  /// The HR Hub's own id for this branch inside HrWorkspace.state. Set explicitly (seed or Administration), never matched by name.
  hrBranchKey    String?
  staff          StaffMember[]
  areas          Area[]
  serviceUsers   ServiceUser[]
  grants         MembershipBranch[]
  policyProfile  BranchPolicyProfile?
  policyScopes   PolicyBranchScope[]

  @@unique([organisationId, hrBranchKey])
  @@index([organisationId])
}

model BranchServiceType {
  branchId        String
  serviceTypeCode String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceType     ServiceType @relation(fields: [serviceTypeCode], references: [code])

  @@id([branchId, serviceTypeCode])
}

model Membership {
  id                      String             @id @default(cuid())
  userId                  String
  organisationId          String
  branchId                String?
  roles                   OrgRole[]
  jobTitle                String?
  /// The HR Hub account this member works as in HR & Workforce. Empty means no HR access.
  hrUserId                String?
  createdAt               DateTime           @default(now())
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation            Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branch                  Branch?            @relation(fields: [branchId], references: [id])
  /// Areas a care coordinator is limited to. None means every area in the organisation.
  areas                   MembershipArea[]
  /// Branches this member may work in. None means every branch in the organisation (the single-branch default).
  branches                MembershipBranch[]
  /// Set when an administrator deactivates the member: roles are cleared and kept here for reactivation.
  deactivatedAt           DateTime?
  rolesBeforeDeactivation OrgRole[]          @default([])
  /// The member's own order for the module boxes on the Overview (module ids). Empty means the standard order.
  overviewOrder           String[]           @default([])

  @@unique([userId, organisationId])
  @@index([organisationId])
}

/// An explicit, audited grant of access to a branch. Scope is derived from these on every request.
model MembershipBranch {
  membershipId String
  branchId     String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())
  grantedById  String?

  @@id([membershipId, branchId])
}

/// HR & Workforce (the CSB HR Hub) for one organisation. The HR Hub keeps its records as one document,
/// exactly as in the standalone pilot; this row replaces the pilot's local SQLite file. Writes lock the
/// row (SELECT ... FOR UPDATE) so two changes never overwrite each other.
model HrWorkspace {
  organisationId String       @id
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  state          Json
  version        Int          @default(1)
  updatedAt      DateTime     @updatedAt
}

/// HR Hub document files (uploads stay in quarantine). Kept in the database for the demo so they
/// survive serverless deploys; production moves them to Blob storage behind a malware scanner.
model HrFile {
  key            String   @id
  organisationId String
  mime           String
  bytes          Bytes
  createdAt      DateTime @default(now())

  @@index([organisationId])
}

// ───────────────────────────── Regulatory sources ─────────────────────────────

enum SourceCategory {
  REGULATOR
  LEGISLATION
  GOVERNMENT_GUIDANCE
  CLINICAL_GUIDANCE
  WORKFORCE
  BEST_PRACTICE
  HEALTH_AND_SAFETY
  DATA_PROTECTION
  FOOD_SAFETY
  NHS
}

enum MonitoringMethod {
  GOVUK_CONTENT_API // https://www.gov.uk/api/content/<path>
  GOVUK_SEARCH_API // https://www.gov.uk/api/search.json
  ATOM_FEED
  RSS_FEED
  LEGISLATION_GOV_UK // CLML XML data endpoints
  HTML_PAGE // permitted page retrieval
  MANUAL // manual review only, no automated retrieval
}

enum MonitoringCoverage {
  AUTOMATED // full text retrieved and compared
  PARTIAL // metadata/feed only, or subset of content
  MANUAL_REVIEW_ONLY
}

enum RetrievalStatus {
  NEVER_CHECKED
  OK
  DEGRADED // last run failed but previous success within freshness window
  FAILING
  DISABLED
}

model RegulatorySource {
  id                    String             @id @default(cuid())
  key                   String             @unique
  name                  String
  canonicalUrl          String
  category              SourceCategory
  jurisdiction          String             @default("ENG")
  serviceTypes          String[]           @default([])
  monitoringMethod      MonitoringMethod
  coverage              MonitoringCoverage
  config                Json               @default("{}")
  frequencyMinutes      Int                @default(1440)
  freshnessWindowHours  Int                @default(48)
  lastAttemptedAt       DateTime?
  lastSuccessAt         DateTime?
  lastContentCheckedAt  DateTime?
  lastChangeDetectedAt  DateTime?
  nextCheckAt           DateTime?
  retrievalStatus       RetrievalStatus    @default(NEVER_CHECKED)
  consecutiveFailures   Int                @default(0)
  lastError             String?
  currentContentHash    String?
  latestPublishedAt     DateTime?
  latestModifiedAt      DateTime?
  licence               String?
  reuseNotes            String?
  monitoringNotes       String?
  active                Boolean            @default(true)
  isSimulated           Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  /// Where the source applies (branch-specific policy generation). National sources apply everywhere in England;
  /// regional ones only to the listed regions; local ones only to the listed local authorities. Never inferred.
  geoLevel              GeoLevel           @default(NATIONAL)
  regionCodes           String[]           @default([])
  localAuthorityCodes   String[]           @default([])
  issuingOrganisation   String?
  /// Policy category codes the source is relevant to. Empty = every category.
  topics                String[]           @default([])
  documentReference     String?
  publishedOn           DateTime?          @db.Date
  effectiveOn           DateTime?          @db.Date
  versionLabel          String?
  /// CURRENT | SUPERSEDED. A superseded source is kept (history is never deleted) and points at its replacement.
  lifecycle             String             @default("CURRENT")
  supersededById        String?
  /// What the source says, in CSB's own words, as recorded by the person who checked it. Used when drafting.
  referenceSummary      String?
  /// The organisation that proposed this public source (not shown to other organisations).
  addedByOrganisationId String?

  documents    SourceDocument[]
  runs         SourceRetrievalRun[]
  changes      RegulatoryChange[]
  requirements RegulatoryRequirement[]
  orgReviews   OrgSourceReview[]
  policyLinks  PolicySourceLink[]
}

model SourceDocument {
  id               String           @id @default(cuid())
  sourceId         String
  source           RegulatorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId       String // e.g. GOV.UK content_id, legislation URI, feed entry id
  url              String
  title            String
  documentType     String?
  legalStatus      LegalStatus      @default(ADVISORY_GUIDANCE)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  currentVersionId String?          @unique
  currentVersion   SourceVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  withdrawnAt      DateTime?
  isSimulated      Boolean          @default(false)

  versions     SourceVersion[]         @relation("DocumentVersions")
  requirements RegulatoryRequirement[]

  @@unique([sourceId, externalId])
}

model SourceVersion {
  id             String              @id @default(cuid())
  documentId     String
  document       SourceDocument      @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber  Int
  contentHash    String
  normalisedText String
  sections       Json // [{ ref, heading, text }]
  rawStorageKey  String? // original retrieved bytes in object storage
  contentType    String?
  retrievedAt    DateTime
  publishedAt    DateTime? // official, as supplied by the source
  modifiedAt     DateTime? // official, as supplied by the source
  metadata       Json                @default("{}")
  runId          String?
  run            SourceRetrievalRun? @relation(fields: [runId], references: [id])
  isSimulated    Boolean             @default(false)
  createdAt      DateTime            @default(now())

  currentOf     SourceDocument?    @relation("CurrentVersion")
  changesAsNew  RegulatoryChange[] @relation("ChangeNewVersion")
  changesAsPrev RegulatoryChange[] @relation("ChangePrevVersion")
  chunks        DocumentChunk[]
  citations     AiCitation[]

  @@unique([documentId, versionNumber])
  @@index([documentId, contentHash])
}

enum RunTrigger {
  SCHEDULED
  MANUAL
  RETRY
  TEST
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model SourceRetrievalRun {
  id                  String            @id @default(cuid())
  sourceId            String
  source              RegulatorySource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jobId               String?
  trigger             RunTrigger
  status              RunStatus         @default(RUNNING)
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  documentsDiscovered Int               @default(0)
  documentsChecked    Int               @default(0)
  documentsNew        Int               @default(0)
  documentsChanged    Int               @default(0)
  documentsFailed     Int               @default(0)
  contentChecked      Boolean           @default(false)
  error               String?
  versions            SourceVersion[]
  events              ProcessingEvent[]

  @@index([sourceId, startedAt])
}

model ProcessingEvent {
  id        String              @id @default(cuid())
  runId     String?
  run       SourceRetrievalRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId  String?
  level     String // info | warn | error
  event     String
  message   String
  data      Json                @default("{}")
  createdAt DateTime            @default(now())

  @@index([runId])
  @@index([sourceId, createdAt])
}

// ───────────────────────────── Regulatory changes ─────────────────────────────

enum ChangeClassification {
  NEW_DOCUMENT
  POTENTIALLY_SUBSTANTIVE
  EDITORIAL
  UNCERTAIN
}

enum ChangeStatus {
  NEWLY_DETECTED
  AWAITING_CLASSIFICATION
  POTENTIALLY_SUBSTANTIVE
  EDITORIAL_OR_IMMATERIAL
  UNDER_REVIEW
  CONFIRMED_RELEVANT
  CONFIRMED_NOT_APPLICABLE
  IMPACT_ASSESSMENT_COMPLETED
  POLICY_REVISION_REQUIRED
  NO_POLICY_REVISION_REQUIRED
  CLOSED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model RegulatoryChange {
  id                     String               @id @default(cuid())
  sourceId               String
  source                 RegulatorySource     @relation(fields: [sourceId], references: [id])
  documentId             String
  previousVersionId      String?
  previousVersion        SourceVersion?       @relation("ChangePrevVersion", fields: [previousVersionId], references: [id])
  newVersionId           String               @unique // idempotency: one change per new version
  newVersion             SourceVersion        @relation("ChangeNewVersion", fields: [newVersionId], references: [id])
  canonicalUrl           String
  title                  String
  retrievedAt            DateTime
  officialDate           DateTime?
  classification         ChangeClassification
  classificationBasis    String // "rules" | "ai" | "reviewer"
  status                 ChangeStatus         @default(NEWLY_DETECTED)
  changedSections        Json // [{ ref, heading, kind: added|removed|modified, before, after }]
  summary                String
  suggestedUrgency       Urgency              @default(MEDIUM)
  affectedCategories     String[]             @default([])
  affectedServiceTypes   String[]             @default([])
  affectedRequirementIds String[]             @default([])
  aiAnalysis             Json? // validated structured output (proposal only)
  aiProvider             String?
  aiIsSimulated          Boolean              @default(false)
  confidence             Float?
  uncertainty            String?
  reviewerId             String?
  reviewNotes            String?
  isSimulated            Boolean              @default(false)
  detectedAt             DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  candidates  ChangePolicyCandidate[]
  assessments ImpactAssessment[]
  events      ChangeStatusEvent[]
  citations   AiCitation[]

  @@index([status])
  @@index([sourceId])
}

model ChangeStatusEvent {
  id        String           @id @default(cuid())
  changeId  String
  change    RegulatoryChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  from      ChangeStatus?
  to        ChangeStatus
  actorId   String?
  reason    String?
  createdAt DateTime         @default(now())
}

enum CandidateReason {
  REQUIREMENT_LINK // deterministic: change touches a requirement linked to the policy
  SOURCE_LINK // policy cites this source document
  TEXT_MATCH // full-text similarity (supporting evidence only)
  CATEGORY_MATCH
}

model ChangePolicyCandidate {
  id             String           @id @default(cuid())
  changeId       String
  change         RegulatoryChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  policyId       String
  policy         Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organisationId String? // null for master templates
  reason         CandidateReason
  requirementId  String           @default("") // "" when not requirement-based
  sectionKey     String?
  evidence       String
  score          Float?
  createdAt      DateTime         @default(now())

  @@unique([changeId, policyId, reason, requirementId])
  @@index([organisationId])
}

// ───────────────────────────── Requirements register ─────────────────────────────

enum LegalStatus {
  LEGISLATION
  STATUTORY_GUIDANCE
  REGULATOR_GUIDANCE
  ADVISORY_GUIDANCE
  BEST_PRACTICE
  INTERNAL_POLICY
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  NEEDS_REVIEW
}

model RegulatoryRequirement {
  id                    String             @id @default(cuid())
  ref                   String             @unique
  jurisdiction          String             @default("ENG")
  title                 String
  sourceId              String
  source                RegulatorySource   @relation(fields: [sourceId], references: [id])
  sourceDocumentId      String?
  sourceDocument        SourceDocument?    @relation(fields: [sourceDocumentId], references: [id])
  exactReference        String // e.g. "Regulation 13(2)"
  sourceSectionRef      String? // section ref inside SourceVersion.sections
  sourceUrl             String
  excerpt               String
  legalStatus           LegalStatus
  serviceTypes          String[]           @default([])
  applicabilityNotes    String?
  effectiveDate         DateTime?
  effectiveDateVerified Boolean            @default(false)
  lastVerifiedAt        DateTime?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  reviewStatus          String             @default("ACTIVE") // ACTIVE | UNDER_REVIEW | RETIRED
  version               Int                @default(1)
  isSimulated           Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  versions       RequirementVersion[]
  policyLinks    RequirementPolicyLink[]
  auditQuestions AuditQuestionRequirement[]
  trainingLinks  TrainingRequirementLink[]
}

model RequirementVersion {
  id            String                @id @default(cuid())
  requirementId String
  requirement   RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  reason        String
  changedById   String?
  createdAt     DateTime              @default(now())

  @@unique([requirementId, version])
}

model RequirementPolicyLink {
  id            String                @id @default(cuid())
  requirementId String
  requirement   RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  policyId      String
  policy        Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sectionKey    String? // stable section key within the policy
  rationale     String
  createdById   String?
  createdAt     DateTime              @default(now())

  @@unique([requirementId, policyId, sectionKey])
  @@index([policyId])
}

// ───────────────────────────── Policies ─────────────────────────────

enum PolicyKind {
  MASTER // CSB-maintained template (organisationId is null)
  CUSTOMER // organisation-owned policy, optionally derived from a master
}

enum PolicyStatus {
  ACTIVE
  ARCHIVED
}

enum VersionStatus {
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
  REJECTED
}

enum VersionOrigin {
  SEED
  MANUAL
  AI_REGULATORY_REVISION
  MASTER_SYNC
  ROLLBACK
  GENERATED
}

model PolicyCategory {
  code     String   @id
  name     String
  policies Policy[]
}

model Policy {
  id                          String                   @id @default(cuid())
  kind                        PolicyKind
  organisationId              String?
  organisation                Organisation?            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branchId                    String?
  templateId                  String?
  template                    Policy?                  @relation("TemplateDerivations", fields: [templateId], references: [id])
  derived                     Policy[]                 @relation("TemplateDerivations")
  ref                         String
  title                       String
  description                 String
  categoryCode                String
  category                    PolicyCategory           @relation(fields: [categoryCode], references: [code])
  docType                     String                   @default("POLICY") // POLICY | PROCEDURE | FORM | CHECKLIST | RISK_ASSESSMENT | AUDIT_TOOL | TEMPLATE | GUIDANCE
  serviceTypes                String[]                 @default([])
  jurisdiction                String                   @default("ENG")
  status                      PolicyStatus             @default(ACTIVE)
  ownerId                     String?
  reviewerId                  String?
  approverId                  String?
  reviewIntervalMonths        Int                      @default(12)
  nextReviewDate              DateTime?
  currentPublishedVersionId   String?                  @unique
  currentPublishedVersion     PolicyVersion?           @relation("CurrentPublished", fields: [currentPublishedVersionId], references: [id])
  lockVersion                 Int                      @default(0) // optimistic concurrency for publishing
  supportingSourceDocumentIds String[]                 @default([])
  isDemo                      Boolean                  @default(false)
  /// NATIONAL (one policy for everyone), SHARED_WITH_APPENDICES (one policy with a local appendix per branch) or
  /// BRANCH_SPECIFIC (a separate policy for one branch, with parentPolicyId naming the company policy).
  scopeMode                   PolicyScopeMode          @default(NATIONAL)
  parentPolicyId              String?
  parentPolicy                Policy?                  @relation("BranchVariants", fields: [parentPolicyId], references: [id])
  branchVariants              Policy[]                 @relation("BranchVariants")
  searchVector                Unsupported("tsvector")? @map("search_vector") // generated column, see integrity migration
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  versions         PolicyVersion[]         @relation("PolicyVersions")
  requirementLinks RequirementPolicyLink[]
  candidates       ChangePolicyCandidate[]
  assessments      ImpactAssessment[]
  revisions        PolicyRevision[]
  publications     PolicyPublication[]
  auditQuestions   AuditQuestion[]
  assignmentRules  PolicyAssignmentRule[]
  branchScopes     PolicyBranchScope[]
  sourceLinks      PolicySourceLink[]
  generationRuns   PolicyGenerationRun[]
  resourceLinks    PolicyResourceLink[]    @relation("PolicyResourceLinks")
  linkedFrom       PolicyResourceLink[]    @relation("ResourceLinkedFrom")

  @@unique([organisationId, ref])
  @@index([searchVector], map: "policy_search_idx", type: Gin)
  @@index([organisationId])
  @@index([templateId])
  @@index([docType])
}

model PolicyVersion {
  id                     String        @id @default(cuid())
  policyId               String
  policy                 Policy        @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  organisationId         String? // denormalised for tenant scoping
  versionNumber          Int // monotonically increasing per policy
  label                  String // e.g. "2.0" or "2.1-draft"
  status                 VersionStatus @default(DRAFT)
  origin                 VersionOrigin
  previousVersionId      String?
  basedOnMasterVersionId String? // for customer policies: master version this text tracks
  changeSummary          String?
  reasonForChange        String?
  effectiveDate          DateTime?
  approvedAt             DateTime?
  publishedAt            DateTime?
  supersededAt           DateTime?
  createdById            String?
  contentHash            String?
  isSimulated            Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  currentOf       Policy?            @relation("CurrentPublished")
  sections        PolicySection[]
  revisionAsDraft PolicyRevision?    @relation("RevisionDraft")
  revisionsAsBase PolicyRevision[]   @relation("RevisionBase")
  publication     PolicyPublication?
  chunks          DocumentChunk[]
  approvals       ApprovalDecision[]

  @@unique([policyId, versionNumber])
  @@index([organisationId])
}

model PolicySection {
  id        String        @id @default(cuid())
  versionId String
  version   PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key       String // stable key across versions e.g. "procedure.reporting"
  heading   String
  body      String
  position  Int
  isLocal   Boolean       @default(false) // customer-specific: contacts, routes, responsibilities; never auto-modified
  masterKey String? // key of master section this tracks (customer policies)

  @@unique([versionId, key])
}

// ───────────────────────────── Impact & revisions ─────────────────────────────

enum Applicability {
  APPLIES
  DOES_NOT_APPLY
  UNCERTAIN
}

enum AssessmentOutcome {
  REVISION_RECOMMENDED
  NO_REVISION_NEEDED
  UNCERTAIN
  CONFLICT_REQUIRES_EXPERT
}

enum AssessmentStatus {
  PROPOSED
  CONFIRMED_REVISION_REQUIRED
  CONFIRMED_NO_REVISION
  DISMISSED
}

model ImpactAssessment {
  id                  String            @id @default(cuid())
  changeId            String
  change              RegulatoryChange  @relation(fields: [changeId], references: [id], onDelete: Cascade)
  policyId            String
  policy              Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organisationId      String?
  policyVersionId     String // approved version assessed
  applicability       Applicability
  outcome             AssessmentOutcome
  urgency             Urgency
  rationale           String
  needsVerification   String[]          @default([])
  affectedSectionKeys String[]          @default([])
  aiOutput            Json?
  provider            String
  isSimulated         Boolean           @default(false)
  status              AssessmentStatus  @default(PROPOSED)
  reviewerId          String?
  reviewerReason      String?
  reviewedAt          DateTime?
  createdAt           DateTime          @default(now())

  citations AiCitation[]
  revisions PolicyRevision[]

  @@unique([changeId, policyId])
  @@index([organisationId])
}

enum RevisionKind {
  REGULATORY
  MASTER_SYNC
  MANUAL
  ROLLBACK
}

model PolicyRevision {
  id                 String            @id @default(cuid())
  policyId           String
  policy             Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organisationId     String?
  kind               RevisionKind
  impactAssessmentId String?
  impactAssessment   ImpactAssessment? @relation(fields: [impactAssessmentId], references: [id])
  baseVersionId      String?
  baseVersion        PolicyVersion?    @relation("RevisionBase", fields: [baseVersionId], references: [id])
  draftVersionId     String            @unique
  draftVersion       PolicyVersion     @relation("RevisionDraft", fields: [draftVersionId], references: [id])
  urgency            Urgency           @default(MEDIUM)
  substantive        Boolean           @default(true) // substantive changes always require human approval
  title              String
  explanation        String? // AI-generated explanation (proposal)
  validation         Json              @default("{}") // citation checks, unsupported statements, conflicts
  edits              Json              @default("[]") // structured edits applied
  provider           String?
  isSimulated        Boolean           @default(false)
  authorId           String? // person accountable for the draft (submitter); cannot approve it
  submittedAt        DateTime?
  closedAt           DateTime?
  createdById        String?
  dueAt              DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assignments ReviewAssignment[]
  decisions   ApprovalDecision[]
  comments    RevisionComment[]
  citations   AiCitation[]

  @@index([organisationId])
  @@index([policyId])
}

model ReviewAssignment {
  id         String         @id @default(cuid())
  revisionId String
  revision   PolicyRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  assigneeId String
  role       String // REVIEWER | APPROVER
  status     String         @default("PENDING") // PENDING | COMPLETED
  dueAt      DateTime?
  createdAt  DateTime       @default(now())

  @@unique([revisionId, assigneeId, role])
}

enum Decision {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

model ApprovalDecision {
  id         String         @id @default(cuid())
  revisionId String
  revision   PolicyRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  versionId  String
  version    PolicyVersion  @relation(fields: [versionId], references: [id])
  deciderId  String
  role       String
  decision   Decision
  comment    String
  createdAt  DateTime       @default(now())
}

model RevisionComment {
  id         String         @id @default(cuid())
  revisionId String
  revision   PolicyRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  authorId   String
  sectionKey String?
  body       String
  createdAt  DateTime       @default(now())
}

model AiCitation {
  id                 String            @id @default(cuid())
  changeId           String?
  change             RegulatoryChange? @relation(fields: [changeId], references: [id], onDelete: Cascade)
  impactAssessmentId String?
  impactAssessment   ImpactAssessment? @relation(fields: [impactAssessmentId], references: [id], onDelete: Cascade)
  revisionId         String?
  revision           PolicyRevision?   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  assistantQueryId   String?
  sourceVersionId    String?
  sourceVersion      SourceVersion?    @relation(fields: [sourceVersionId], references: [id])
  policyVersionId    String?
  sectionRef         String?
  supportsSectionKey String? // policy section the citation supports
  quote              String
  verified           Boolean
  verificationNote   String?
  createdAt          DateTime          @default(now())
}

// ───────────────────────────── Publishing & acknowledgement ─────────────────────────────

enum PublicationStatus {
  SCHEDULED
  PUBLISHED
  CANCELLED
}

model PolicyPublication {
  /// For branch-specific policies: the manager's pre-publication confirmations (local procedures, contacts, sources,
  /// branches, critical gaps), stored with who and when.
  governanceChecks            Json?
  id                          String            @id @default(cuid())
  policyId                    String
  policy                      Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organisationId              String?
  versionId                   String            @unique
  version                     PolicyVersion     @relation(fields: [versionId], references: [id])
  status                      PublicationStatus
  scheduledFor                DateTime?
  publishedAt                 DateTime?
  effectiveDate               DateTime
  publishedById               String
  requiresAcknowledgement     Boolean           @default(true)
  /// A material change needs fresh acknowledgement; a non-material one (wording, links) keeps the previous evidence.
  materialRevision            Boolean           @default(true)
  acknowledgementDueAt        DateTime?
  implementationConfirmedAt   DateTime?
  implementationConfirmedById String?
  implementationNotes         String?
  createdAt                   DateTime          @default(now())

  acknowledgements Acknowledgement[]

  @@index([organisationId])
}

model Acknowledgement {
  id                 String                 @id @default(cuid())
  publicationId      String
  publication        PolicyPublication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  organisationId     String
  /// The sign-in that can acknowledge. Null for staff with no linked sign-in: they are listed as "cannot sign", never dropped.
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The person (HR projection) the assignment is for, when they have a staff record.
  staffMemberId      String?
  staffMember        StaffMember?           @relation(fields: [staffMemberId], references: [id])
  ruleId             String?
  rule               PolicyAssignmentRule?  @relation(fields: [ruleId], references: [id])
  mandatory          Boolean                @default(true)
  state              AcknowledgementState   @default(ASSIGNED)
  dueAt              DateTime?
  openedAt           DateTime?
  acknowledgedAt     DateTime?
  /// The exact statement agreed to, stored with the time.
  wording            String?
  remindedAt         DateTime?
  escalatedAt        DateTime?
  requiresAssessment Boolean                @default(false)
  assessedAt         DateTime?
  assessedById       String?
  assessmentMethod   String?
  assessmentScore    Int?
  assessmentPassMark Int?
  assessmentNote     String?
  exemptedAt         DateTime?
  exemptedById       String?
  exemptionReason    String?
  withdrawnAt        DateTime?
  withdrawnById      String?
  withdrawnReason    String?
  /// A correction is a new row; the original is kept and marked superseded.
  supersedesId       String?
  supersededAt       DateTime?
  createdAt          DateTime               @default(now())
  events             AcknowledgementEvent[]

  // One current row per publication and person is enforced by partial unique indexes in the migration.
  @@index([publicationId, userId])
  @@index([publicationId, staffMemberId])
  @@index([organisationId, acknowledgedAt])
  @@index([organisationId, state])
}

// ───────────────────────────── Audits, actions, evidence, training ─────────────────────────────

model AuditTemplate {
  id             String          @id @default(cuid())
  organisationId String? // null = CSB master template
  title          String
  description    String?
  version        Int             @default(1)
  status         String          @default("ACTIVE") // DRAFT | ACTIVE | RETIRED
  needsReview    Boolean         @default(false)
  reviewReason   String?
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  questions      AuditQuestion[]
  audits         Audit[]

  @@index([organisationId])
}

model AuditQuestion {
  id           String                     @id @default(cuid())
  templateId   String
  template     AuditTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text         String
  guidance     String?
  position     Int
  policyId     String?
  policy       Policy?                    @relation(fields: [policyId], references: [id])
  requirements AuditQuestionRequirement[]
  answers      AuditAnswer[]
}

model AuditQuestionRequirement {
  questionId    String
  requirementId String
  question      AuditQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requirement   RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([questionId, requirementId])
}

model Audit {
  id              String             @id @default(cuid())
  organisationId  String
  branchId        String?
  templateId      String
  template        AuditTemplate      @relation(fields: [templateId], references: [id])
  templateVersion Int
  title           String
  status          String             @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  conductedById   String
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  completedById   String?
  isDemo          Boolean            @default(false)
  answers         AuditAnswer[]
  answerEvents    AuditAnswerEvent[]
  findings        AuditFinding[]

  @@index([organisationId])
}

model AuditAnswer {
  id         String        @id @default(cuid())
  auditId    String
  audit      Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String
  question   AuditQuestion @relation(fields: [questionId], references: [id])
  response   String // MET | PARTIALLY_MET | NOT_MET | NOT_APPLICABLE
  notes      String?

  @@unique([auditId, questionId])
}

/// Every answer ever recorded, in order. Append-only (database trigger); the current answer is AuditAnswer.
model AuditAnswerEvent {
  id         String   @id @default(cuid())
  auditId    String
  audit      Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String
  actorId    String
  response   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([auditId, questionId, createdAt])
}

model AuditFinding {
  id             String             @id @default(cuid())
  auditId        String
  audit          Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  organisationId String
  questionId     String?
  description    String
  riskRating     String // LOW | MEDIUM | HIGH | CRITICAL
  createdAt      DateTime           @default(now())
  actions        ComplianceAction[]
}

model ComplianceAction {
  id                   String            @id @default(cuid())
  organisationId       String
  findingId            String?
  finding              AuditFinding?     @relation(fields: [findingId], references: [id])
  /// A mitigation action for a risk on the organisational risk register.
  riskId               String?
  risk                 ComplianceRisk?   @relation(fields: [riskId], references: [id])
  title                String
  description          String?
  ownerId              String
  dueDate              DateTime
  status               String            @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | VERIFIED | CLOSED
  completionNote       String?
  completionEvidenceId String?
  completedAt          DateTime?
  verifiedById         String?
  verifiedAt           DateTime?
  closedAt             DateTime?
  isDemo               Boolean           @default(false)
  createdAt            DateTime          @default(now())
  history              ActionEvent[]
  /// CQC Inspection & Evidence: the root cause analysis (and its finding) this action came from.
  rcaId                String?
  rca                  RcaInvestigation? @relation(fields: [rcaId], references: [id])
  rcaFindingId         String?
  rcaFinding           RcaFinding?       @relation(fields: [rcaFindingId], references: [id])
  /// CORRECTIVE (resolve the problem) | PREVENTATIVE (stop it happening again). Null for older actions.
  actionType           String?
  /// LOW | MEDIUM | HIGH | URGENT. Null for older actions.
  priority             String?
  /// What evidence the owner must supply before the action counts as complete.
  evidenceRequired     String?
  /// The CQC readiness assessment (and criterion) the improvement action was raised from.
  cqcAssessmentId      String?
  cqcAssessment        CqcAssessment?    @relation(fields: [cqcAssessmentId], references: [id])
  cqcCriterionId       String?
  cqcCriterion         CqcCriterion?     @relation(fields: [cqcCriterionId], references: [id])

  @@index([organisationId, status])
  @@index([riskId])
  @@index([rcaId])
  @@index([cqcAssessmentId])
}

/// The organisational risk register: governance and service risks, scored on a 5 x 5 likelihood x impact matrix
/// (src/server/compliance/risks.ts). Separate from audit findings, corrective actions and service users' care risk
/// assessments, which may be linked but are different records. Risks are never deleted; they are closed with a reason.
model ComplianceRisk {
  id                   String             @id @default(cuid())
  organisationId       String
  /// null = the whole organisation.
  branchId             String?
  ref                  String
  title                String
  description          String
  category             String
  /// Inherent risk, before controls: 1 (rare / negligible) to 5 (almost certain / catastrophic).
  likelihood           Int
  impact               Int
  existingControls     String
  controlEffectiveness String             @default("NOT_ASSESSED") // EFFECTIVE | PARTIALLY_EFFECTIVE | INEFFECTIVE | NOT_ASSESSED
  /// Residual risk, with the existing controls in place.
  residualLikelihood   Int
  residualImpact       Int
  ownerId              String
  status               String             @default("OPEN") // OPEN | MONITORING | CLOSED
  reviewDate           DateTime
  lastReviewedAt       DateTime?
  lastReviewedById     String?
  /// The audit finding the risk was raised from, if any.
  findingId            String?
  createdById          String
  closedAt             DateTime?
  closedReason         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  events               RiskEvent[]
  actions              ComplianceAction[]

  @@unique([organisationId, ref])
  @@index([organisationId, status])
}

/// Every change to a risk, in order, with what changed and why. Append-only (database trigger).
model RiskEvent {
  id        String         @id @default(cuid())
  riskId    String
  risk      ComplianceRisk @relation(fields: [riskId], references: [id], onDelete: Restrict)
  actorId   String
  kind      String // CREATED | UPDATED | REVIEWED | CLOSED | REOPENED
  note      String?
  changes   Json           @default("{}")
  createdAt DateTime       @default(now())

  @@index([riskId, createdAt])
}

model ActionEvent {
  id        String           @id @default(cuid())
  actionId  String
  action    ComplianceAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actorId   String
  from      String?
  to        String
  note      String?
  createdAt DateTime         @default(now())
}

model EvidenceDocument {
  id             String    @id @default(cuid())
  organisationId String
  filename       String
  contentType    String
  sizeBytes      Int
  sha256         String
  storageKey     String
  scanStatus     String    @default("PENDING") // PENDING | CLEAN | INFECTED | NOT_SCANNED
  description    String?
  linkedType     String? // AUDIT | ACTION | POLICY
  linkedId       String?
  uploadedById   String
  retainUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organisationId])
  /// Evidence shown beside the record it supports (policies, audits, missed calls).
  @@index([organisationId, linkedType, linkedId])
}

model TrainingRequirement {
  id             String                    @id @default(cuid())
  organisationId String? // null = platform suggestion
  title          String
  description    String?
  renewalMonths  Int?
  requirements   TrainingRequirementLink[]
  records        TrainingRecord[]
}

model TrainingRequirementLink {
  trainingId    String
  requirementId String
  training      TrainingRequirement   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  requirement   RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([trainingId, requirementId])
}

model TrainingRecord {
  id             String              @id @default(cuid())
  organisationId String
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId     String
  training       TrainingRequirement @relation(fields: [trainingId], references: [id])
  completedAt    DateTime
  expiresAt      DateTime?
  evidenceId     String?

  @@index([organisationId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id             String                 @id @default(cuid())
  organisationId String?
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  reason         String
  links          Json                   @default("[]") // [{label,url}]
  actionUrl      String?
  dueAt          DateTime?
  dedupeKey      String                 @unique
  readAt         DateTime?
  createdAt      DateTime               @default(now())
  deliveries     NotificationDelivery[]

  @@index([userId, readAt])
}

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           String // EMAIL
  status            String       @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts          Int          @default(0)
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime     @default(now())

  @@unique([notificationId, channel])
}

// ───────────────────────────── Jobs, search, assistant, audit log ─────────────────────────────

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED // will retry
  DEAD // exhausted retries (dead-letter)
  CANCELLED
}

model BackgroundJob {
  id             String    @id @default(cuid())
  type           String
  idempotencyKey String    @unique
  status         JobStatus @default(QUEUED)
  payload        Json      @default("{}")
  result         Json?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(4)
  runAfter       DateTime  @default(now())
  lockedBy       String?
  lockedUntil    DateTime?
  lastError      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([type, createdAt])
}

model DocumentChunk {
  id              String                   @id @default(cuid())
  organisationId  String? // null = shared (regulatory sources, master templates)
  kind            String // SOURCE | POLICY
  sourceVersionId String?
  sourceVersion   SourceVersion?           @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  policyVersionId String?
  policyVersion   PolicyVersion?           @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  policyId        String?
  sectionRef      String
  heading         String
  text            String
  legalStatus     LegalStatus
  isCurrent       Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  searchVector    Unsupported("tsvector")? @map("search_vector") // generated column + GIN index, see integrity migration

  @@index([organisationId])
  @@index([searchVector], map: "document_chunk_search_idx", type: Gin)
  @@index([sourceVersionId])
  @@index([policyVersionId])
}

model AssistantQuery {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  question       String
  answer         Json
  provider       String
  createdAt      DateTime @default(now())

  @@index([organisationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String
  data           Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Workforce (shared staff identity) ─────────────────────────────
// HR & Workforce (the HR Hub's HrWorkspace.state) is the source of truth for employees. StaffMember is the
// relational identity every other module points at, projected from HR in the same transaction as each HR change
// (src/server/workforce/projection.ts). Rostering never edits the projected fields.

enum EmploymentStatus {
  ACTIVE
  ONBOARDING
  /// Suspended in HR: still employed, never bookable. Future visits are flagged, not removed.
  SUSPENDED
  ARCHIVED
}

enum CarerGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

model StaffMember {
  id                  String                        @id @default(cuid())
  organisationId      String
  organisation        Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// The HR Hub employee id. One-to-one with the HR employee; never changes.
  hrEmployeeId        String
  hrVersion           Int
  /// Hash of the projected content, so unchanged employees are not rewritten.
  hrHash              String
  /// The HR employee no longer exists in the HR document. Kept so delivered visits keep their carer.
  hrMissing           Boolean                       @default(false)
  staffNumber         String
  displayName         String
  preferredName       String?
  jobTitle            String
  employmentStatus    EmploymentStatus
  hrBranchKey         String
  branchId            String?
  branch              Branch?                       @relation(fields: [branchId], references: [id])
  startDate           DateTime?                     @db.Date
  leavingDate         DateTime?                     @db.Date
  workEmail           String?
  workPhone           String?
  /// The login linked through the explicit, audited administrator workflow. Never set by matching e-mail.
  userId              String?
  linkedById          String?
  linkedAt            DateTime?
  projectedAt         DateTime
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  missedConfirmations MissedCallCarerConfirmation[]
  formLinks           FormRecordLink[]

  profile            RotaStaffProfile?
  compliance         StaffCompliance[]
  areas              StaffArea[]
  absences           StaffAbsence[]
  availability       StaffAvailability[]
  medicationLeads    VisitMedicationLead[]
  assignments        VisitAssignment[]
  preferences        CarerPreference[]
  payRates           StaffPayRate[]
  trainingRecords    StaffTrainingRecord[]
  assessments        CompetencyAssessment[]
  restrictions       StaffRestriction[]
  exceptions         ReadinessException[]
  acknowledgements   Acknowledgement[]
  readinessFlags     StaffReadinessFlag[]
  readinessSnapshots StaffReadinessSnapshot[]

  @@unique([organisationId, hrEmployeeId])
  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([organisationId, employmentStatus])
}

/// What eligibility needs from each HR check. No certificate numbers, documents or notes.
model StaffCompliance {
  id             String      @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hrCheckId      String
  /// DBS, Right to work, Training or another HR category.
  category       String
  name           String
  required       Boolean
  recurring      Boolean
  dueDate        DateTime?   @db.Date
  verified       Boolean
  hasEvidence    Boolean

  @@unique([staffId, hrCheckId])
  @@index([organisationId])
}

/// Rostering-owned settings for a staff member. No row means the defaults.
model RotaStaffProfile {
  staffId          String       @id
  staff            StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organisationId   String
  /// Null means the default: on for care roles, off for everyone else.
  rotaEnabled      Boolean?
  gender           CarerGender?
  drives           Boolean      @default(false)
  maxWeeklyMinutes Int?
  notes            String?
  updatedById      String?
  updatedAt        DateTime     @updatedAt
}

model Area {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  name           String
  colour         String           @default("#6b46c9")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  staff          StaffArea[]
  members        MembershipArea[]
  serviceUsers   ServiceUser[]
  visits         Visit[]

  @@unique([organisationId, name])
}

model StaffArea {
  staffId        String
  areaId         String
  organisationId String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  area           Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([staffId, areaId])
}

model MembershipArea {
  membershipId String
  areaId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([membershipId, areaId])
}

enum AbsenceKind {
  HOLIDAY
  SICKNESS
  COMPASSIONATE
  TRAINING
  UNPAID
  OTHER
}

enum AbsenceStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELLED
}

/// Holidays and sickness. Controlled by HR & Workforce; Rostering reads them.
model StaffAbsence {
  id             String        @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind           AbsenceKind
  startsAt       DateTime
  endsAt         DateTime
  status         AbsenceStatus @default(REQUESTED)
  reason         String?
  requestedById  String
  requestedAt    DateTime      @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  version        Int           @default(1)

  @@index([organisationId, staffId, startsAt])
}

enum AvailabilityKind {
  AVAILABLE
  UNAVAILABLE
}

/// A weekly working pattern. Controlled by HR & Workforce.
model StaffAvailability {
  id             String           @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// ISO weekday: 1 Monday … 7 Sunday.
  weekday        Int
  startMinute    Int
  endMinute      Int
  kind           AvailabilityKind @default(AVAILABLE)
  effectiveFrom  DateTime         @db.Date
  effectiveTo    DateTime?        @db.Date
  note           String?
  createdById    String
  createdAt      DateTime         @default(now())

  @@index([organisationId, staffId])
}

// ───────────────────────────── Service users and care records ─────────────────────────────

enum ServiceUserStatus {
  ENQUIRY
  ASSESSMENT
  ACTIVE
  PAUSED
  ENDED
}

enum GenderPreference {
  ANY
  FEMALE
  MALE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model ServiceUser {
  id                             String            @id @default(cuid())
  organisationId                 String
  organisation                   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branchId                       String?
  branch                         Branch?           @relation(fields: [branchId], references: [id])
  areaId                         String?
  area                           Area?             @relation(fields: [areaId], references: [id])
  reference                      String
  csbReference                   String? // Permanent CSB identifier, distinct from legacy SU reference
  firstName                      String
  lastName                       String
  preferredName                  String?
  dateOfBirth                    DateTime?         @db.Date
  gender                         String?
  pronouns                       String?
  nhsNumber                      String?
  status                         ServiceUserStatus @default(ENQUIRY)
  startDate                      DateTime?         @db.Date
  endDate                        DateTime?         @db.Date
  endReason                      String?
  addressLine1                   String?
  addressLine2                   String?
  town                           String?
  postcode                       String?
  phone                          String?
  /// A second number for the person, when they have one.
  altPhone                       String?
  email                          String?
  /// How the person prefers to be contacted: PHONE | SMS | EMAIL | OTHER (null = not recorded).
  preferredContactMethod         String?
  /// How to get in, parking, pets. Shown to carers on their own visits.
  accessNotes                    String?
  /// AES-256-GCM ciphertext. Revealed only with serviceUser.keysafe, and every reveal is audited.
  keySafeCipher                  String?
  keySafeUpdatedAt               DateTime?
  carerGenderPreference          GenderPreference  @default(ANY)
  firstLanguage                  String?
  communicationNeeds             String?
  carePreferences                String?
  riskLevel                      RiskLevel?
  riskSummary                    String?
  /// Cross-boundary safeguarding (recorded by the office, never worked out automatically): the local authority the
  /// person lives in, where care is actually delivered, who funds or commissions the care, and the safeguarding
  /// authority a manager has recorded (see SafeguardingAuthorityDecision for the reasoning).
  residenceLocalAuthorityCode    String?
  careLocationLocalAuthorityCode String?
  fundingAuthority               String?
  safeguardingLocalAuthorityCode String?
  version                        Int               @default(1)
  createdById                    String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  externalReferences    ServiceUserExternalReference[]
  contacts              ServiceUserContact[]
  coverContactAttempts  CoverContactAttempt[]
  absences              ServiceUserAbsence[]
  packages              CarePackage[]
  carePlans             CarePlan[]
  intakeReviewItems     CareIntakeReviewItem[]
  risks                 RiskAssessment[]
  incidents             Incident[]
  templates             VisitTemplate[]
  visits                Visit[]
  carerPreferences      CarerPreference[]
  medications           Medication[]
  documents             ServiceUserDocument[]
  bodyMapObservations   BodyMapObservation[]
  safeguardingDecisions SafeguardingAuthorityDecision[]
  callNotes             CallNote[]
  formLinks             FormRecordLink[]

  @@unique([organisationId, reference])
  @@unique([organisationId, csbReference])
  @@unique([id, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, lastName])
  dischargeReviews DischargeReview[]
}

enum ContactKind {
  NEXT_OF_KIN
  FAMILY
  LPA_HEALTH
  LPA_FINANCE
  GP
  PHARMACY
  SOCIAL_WORKER
  DISTRICT_NURSE
  OTHER
}

model ServiceUserContact {
  id                     String                @id @default(cuid())
  organisationId         String
  serviceUserId          String
  serviceUser            ServiceUser           @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  kind                   ContactKind
  name                   String
  relationship           String?
  phone                  String?
  email                  String?
  address                String?
  isEmergency            Boolean               @default(false)
  canReceiveUpdates      Boolean               @default(false)
  /// The person the office calls first. Recorded by hand; never inferred from being next of kin.
  isPrimary              Boolean               @default(false)
  /// A second number for this contact, when recorded.
  altPhone               String?
  /// PHONE | SMS | EMAIL | OTHER (null = not recorded).
  preferredContactMethod String?
  /// Recorded authority to act for the service user: LPA_HEALTH | LPA_FINANCE | DEPUTY | OTHER (null = none recorded).
  /// Never set automatically: being next of kin gives no authority.
  authorityType          String?
  /// What the recorded authority covers, in the office's words.
  authorityScope         String?
  notes                  String?
  createdAt              DateTime              @default(now())
  coverContactAttempts   CoverContactAttempt[]

  @@index([serviceUserId])
}

enum ServiceUserAbsenceReason {
  HOSPITAL
  RESPITE
  HOLIDAY
  OTHER
}

/// Periods when the person does not need visits (hospital, respite, holiday). Builds skip them.
model ServiceUserAbsence {
  id             String                   @id @default(cuid())
  organisationId String
  serviceUserId  String
  serviceUser    ServiceUser              @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  reason         ServiceUserAbsenceReason
  startsAt       DateTime
  endsAt         DateTime?
  note           String?
  createdById    String
  createdAt      DateTime                 @default(now())
  cancelledAt    DateTime?
  cancelledById  String?

  @@index([organisationId, serviceUserId, startsAt])
}

enum PackageStatus {
  ACTIVE
  ENDED
}

model CarePackage {
  id                         String        @id @default(cuid())
  organisationId             String
  serviceUserId              String
  serviceUser                ServiceUser   @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  funderId                   String?
  funder                     Funder?       @relation(fields: [funderId], references: [id])
  reference                  String?
  commissionedMinutesPerWeek Int?
  startDate                  DateTime      @db.Date
  endDate                    DateTime?     @db.Date
  status                     PackageStatus @default(ACTIVE)
  /// Visit requirements in plain words (e.g. "4 calls a day, double-up for hoist transfers").
  requirements               String?
  createdAt                  DateTime      @default(now())

  @@index([organisationId, serviceUserId])
}

/// A coordinator's record of continuity: preferred or blocked carers for a person.
model CarerPreference {
  id             String      @id @default(cuid())
  organisationId String
  serviceUserId  String
  serviceUser    ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  rating         Int?
  blocked        Boolean     @default(false)
  reason         String?
  updatedById    String
  updatedAt      DateTime    @updatedAt

  @@unique([serviceUserId, staffId])
}

enum CarePlanStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  SUPERSEDED
}

/// A person-centred care plan. Versions are immutable once they leave draft (database trigger).
model CarePlan {
  id               String                    @id @default(cuid())
  organisationId   String
  serviceUserId    String
  serviceUser      ServiceUser               @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  version          Int
  status           CarePlanStatus            @default(DRAFT)
  summary          String?
  reviewDue        DateTime?                 @db.Date
  createdById      String
  createdAt        DateTime                  @default(now())
  submittedById    String?
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  supersededAt     DateTime?
  /// The Care Summary a manager started this review from, if any. The summary text is never copied into the plan.
  sourceSummaryId  String?
  /// MANUAL (written in CSB) or DOCUMENT (imported from a council support plan by CSB AI).
  origin           String                    @default("MANUAL")
  /// The Care Coordinator intake it was imported from, and which documents and pages.
  sourceIntakeId   String?
  sourceNote       String?
  sections         CarePlanSection[]
  acknowledgements CarePlanAcknowledgement[]

  @@unique([serviceUserId, version])
  @@index([organisationId, status])
}

model CarePlanSection {
  id         String   @id @default(cuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  key        String
  title      String
  body       String
  outcomes   String?
  position   Int

  @@unique([carePlanId, key])
}

/// A carer confirming they have read the current care plan.
model CarePlanAcknowledgement {
  id             String   @id @default(cuid())
  organisationId String
  carePlanId     String
  carePlan       CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  staffId        String
  userId         String
  acknowledgedAt DateTime @default(now())

  @@unique([carePlanId, staffId])
}

enum RiskType {
  ENVIRONMENT
  MOVING_HANDLING
  FALLS
  PRESSURE_SKIN
  MEDICATION_SUPPORT
  NUTRITION
  LONE_WORKING
  OTHER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model RiskAssessment {
  id                String                  @id @default(cuid())
  organisationId    String
  serviceUserId     String
  serviceUser       ServiceUser             @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  type              RiskType
  title             String
  hazards           String
  controls          String
  level             RiskLevel
  reviewDue         DateTime                @db.Date
  status            RecordStatus            @default(ACTIVE)
  assessedById      String
  assessedAt        DateTime                @default(now())
  archivedById      String?
  archivedAt        DateTime?
  version           Int                     @default(1)
  /// What still has to be done to reduce the risk (not the standing controls), and who is responsible for it.
  requiredActions   String?
  responsiblePerson String?
  /// MANUAL, DOCUMENT (a completed assessment in a source document) or AI_INFERRED (CSB AI wrote it from the
  /// document's narrative: assessment information, not a completed clinical assessment).
  origin            String                  @default("MANUAL")
  sourceIntakeId    String?
  sourceNote        String?
  versions          RiskAssessmentVersion[]

  @@index([organisationId, serviceUserId])
}

/// Every saved state of a risk assessment, kept for good: created, each review, archiving. Rows cannot be edited.
model RiskAssessmentVersion {
  id                String         @id @default(cuid())
  organisationId    String
  riskAssessmentId  String
  riskAssessment    RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  version           Int
  change            String
  reason            String?
  type              RiskType
  title             String
  hazards           String
  controls          String
  level             RiskLevel
  reviewDue         DateTime       @db.Date
  requiredActions   String?
  responsiblePerson String?
  status            RecordStatus
  changedById       String
  changedAt         DateTime       @default(now())

  @@unique([riskAssessmentId, version])
  @@index([organisationId])
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

model Incident {
  id                         String               @id @default(cuid())
  organisationId             String
  reference                  String
  serviceUserId              String?
  serviceUser                ServiceUser?         @relation(fields: [serviceUserId], references: [id])
  staffId                    String?
  visitId                    String?
  occurredAt                 DateTime
  category                   String
  severity                   IncidentSeverity
  description                String
  immediateAction            String?
  /// Who was told at the time (family, GP, social worker...), as the reporter wrote it.
  peopleNotified             String?
  safeguarding               Boolean              @default(false)
  /// Flags that a statutory notification may be needed. The platform never sends one itself.
  notifiable                 Boolean              @default(false)
  status                     IncidentStatus       @default(OPEN)
  reportedById               String
  reportedAt                 DateTime             @default(now())
  investigatorId             String?
  outcome                    String?
  closedById                 String?
  closedAt                   DateTime?
  version                    Int                  @default(1)
  bodyMapObservations        BodyMapObservation[]
  /// The local authority area where the incident happened, as recorded by the office.
  occurredLocalAuthorityCode String?

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  /// A service user's record lists their recent incidents.
  @@index([serviceUserId, occurredAt])
}

// ───────────────────────────── Rostering ─────────────────────────────

enum ComplianceRule {
  BLOCK
  REVIEW
  IGNORE
}

/// One row per organisation: how the rota and call monitoring behave.
model RotaSettings {
  organisationId               String         @id
  cycleLength                  Int            @default(4)
  /// The Monday of a "Week 1" of the cycle.
  anchorMonday                 DateTime       @db.Date
  buildAheadWeeks              Int            @default(2)
  lateAfterMin                 Int            @default(10)
  missedAfterMin               Int            @default(30)
  earlyBeforeMin               Int            @default(10)
  blockEarlyClockIn            Boolean        @default(false)
  shortVisitPercent            Int            @default(75)
  requireNoteOnShortVisit      Boolean        @default(true)
  dbsRule                      ComplianceRule @default(BLOCK)
  rightToWorkRule              ComplianceRule @default(BLOCK)
  trainingRule                 ComplianceRule @default(REVIEW)
  /// Job titles (from HR) that count as care roles.
  careRoleTitles               String[]       @default([])
  minPreferenceRating          Int?
  geofenceMetres               Int            @default(150)
  carerDaysForward             Int            @default(7)
  carerDaysBack                Int            @default(1)
  mandatoryClockOutNote        Boolean        @default(false)
  doorstepCancel               Boolean        @default(true)
  /// The target time from "visit became late or missed" to "coordinator alerted", in seconds.
  alertLatencyTargetSec        Int            @default(300)
  /// Missed Calls: a care worker with this many carer-attributable missed calls inside the window is a repeat offender.
  repeatOffenderCount          Int            @default(3)
  /// Missed Calls: a service user missed this many times inside the window is a repeat service-user incident.
  repeatClientCount            Int            @default(2)
  /// Missed Calls: the rolling window, in days, for both repeat rules.
  repeatWindowDays             Int            @default(30)
  /// Medication records are off until an admin switches them on after a clinical review (recorded here).
  medicationEnabledAt          DateTime?
  medicationEnabledById        String?
  medicationReviewNote         String?
  /// Care Summary may use the AI service only after an admin records the data-protection and clinical-safety review.
  careSummaryEnabledAt         DateTime?
  careSummaryEnabledById       String?
  careSummaryReviewNote        String?
  /// Body map AI-Assisted Recommendations: off until an admin records the data-protection and clinical-safety review.
  bodyMapAiEnabledAt           DateTime?
  bodyMapAiEnabledById         String?
  bodyMapAiReviewNote          String?
  /// AI Care Coordinator document reading: off until an admin records the data-protection and clinical-safety review.
  /// While off, documents are read on our own server from their text layer only (nothing is sent to an AI service).
  careCoordinatorAiEnabledAt   DateTime?
  careCoordinatorAiEnabledById String?
  careCoordinatorAiReviewNote  String?
  /// Missed call automation (each stage has its own switch, off by default; switching off is the rollback).
  /// Evidence: collect the system's records into a dated snapshot and timeline for each missed call.
  missedAutoEvidenceAt         DateTime?
  missedAutoEvidenceById       String?
  /// Carer confirmation: ask each booked carer with a linked sign-in what happened, in the app.
  missedAutoConfirmAt          DateTime?
  missedAutoConfirmById        String?
  /// Summary: a rules-based suggested reason for the coordinator to accept or reject. Never recorded by itself.
  missedAutoSummaryAt          DateTime?
  missedAutoSummaryById        String?
  /// Minutes a carer has to answer before the coordinator is told; reminders sent before that (0-2) and when.
  missedConfirmMinutes         Int            @default(60)
  missedConfirmReminders       Int            @default(1)
  missedConfirmReminderMinutes Int            @default(30)
  updatedById                  String?
  updatedAt                    DateTime       @updatedAt
}

model CallType {
  id                 String          @id @default(cuid())
  organisationId     String
  name               String
  defaultDurationMin Int             @default(30)
  monitored          Boolean         @default(true)
  chargeable         Boolean         @default(true)
  active             Boolean         @default(true)
  templates          VisitTemplate[]
  visits             Visit[]

  @@unique([organisationId, name])
}

model CareTask {
  id             String         @id @default(cuid())
  organisationId String
  name           String
  description    String?
  active         Boolean        @default(true)
  templates      TemplateTask[]

  @@unique([organisationId, name])
}

enum RotaType {
  NORMAL
  ALTERNATE
}

/// A recurring visit: which cycle weeks and weekdays, when, how long, how many carers.
model VisitTemplate {
  id                     String         @id @default(cuid())
  organisationId         String
  serviceUserId          String
  serviceUser            ServiceUser    @relation(fields: [serviceUserId], references: [id])
  callTypeId             String
  callType               CallType       @relation(fields: [callTypeId], references: [id])
  areaId                 String?
  /// Cycle weeks 1–4 this visit happens in.
  cycleWeeks             Int[]
  /// ISO weekdays 1 (Monday) … 7 (Sunday).
  weekdays               Int[]
  /// Local (Europe/London) wall-clock start, minutes after midnight.
  startMinute            Int
  durationMin            Int
  carersRequired         Int            @default(1)
  preferredStaff1Id      String?
  preferredStaff2Id      String?
  /// Preferred carers for places 3 and above, in place order ("" = no preference for that place).
  extraPreferredStaffIds String[]       @default([])
  shadowStaffId          String?
  timeLocked             Boolean        @default(false)
  medicationRequired     Boolean        @default(false)
  alertOnLate            Boolean        @default(true)
  rotaType               RotaType       @default(NORMAL)
  runRouteTemplateId     String?
  /// Position on its template run route, carried into each built visit.
  routeOrder             Int?
  enabled                Boolean        @default(true)
  effectiveFrom          DateTime       @db.Date
  effectiveTo            DateTime?      @db.Date
  notes                  String?
  version                Int            @default(1)
  createdById            String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  tasks                  TemplateTask[]
  visits                 Visit[]

  @@index([organisationId, serviceUserId])
  @@index([organisationId, enabled])
  instructionVersions CareInstructionVersion[]
}

model TemplateTask {
  templateId String
  careTaskId String
  template   VisitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  careTask   CareTask      @relation(fields: [careTaskId], references: [id])

  @@id([templateId, careTaskId])
}

enum RotaBuildStatus {
  BUILT
  DELETED
}

model RotaBuild {
  id              String          @id @default(cuid())
  organisationId  String
  weekStart       DateTime        @db.Date
  cycleWeek       Int
  areaIds         String[]
  status          RotaBuildStatus @default(BUILT)
  builtById       String
  builtAt         DateTime        @default(now())
  visitCount      Int
  skippedCount    Int             @default(0)
  unassignedSlots Int
  forecastMinutes Int
  summary         Json            @default("{}")
  deletedById     String?
  deletedAt       DateTime?
  /// Set when the build was made for one service user (Create Future Rota on their profile); null for a whole-week build.
  serviceUserId   String?
  visits          Visit[]

  @@index([organisationId, weekStart])
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  NOT_DELIVERED
}

enum VisitCompletionSource {
  OFFICE_CONFIRMED
}

model Visit {
  id                   String                 @id @default(cuid())
  organisationId       String
  organisation         Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reference            String
  serviceUserId        String
  serviceUser          ServiceUser            @relation(fields: [serviceUserId], references: [id])
  callTypeId           String
  callType             CallType               @relation(fields: [callTypeId], references: [id])
  areaId               String?
  area                 Area?                  @relation(fields: [areaId], references: [id])
  templateId           String?
  template             VisitTemplate?         @relation(fields: [templateId], references: [id])
  rotaBuildId          String?
  rotaBuild            RotaBuild?             @relation(fields: [rotaBuildId], references: [id])
  runRouteId           String?
  runRoute             RunRoute?              @relation(fields: [runRouteId], references: [id])
  /// Position on its run route that day, set by hand by the coordinator.
  routeOrder           Int?
  runOrder             Int?
  /// The local (Europe/London) date the visit starts on.
  date                 DateTime               @db.Date
  scheduledStart       DateTime
  scheduledEnd         DateTime
  carersRequired       Int                    @default(1)
  status               VisitStatus            @default(SCHEDULED)
  statusChangedAt      DateTime               @default(now())
  actualStart          DateTime?
  actualEnd            DateTime?
  cancelReason         String?
  cancelledById        String?
  cancelledAt          DateTime?
  /// The office's decision when cancelling: true charge the cancellation, false do not, null follow the funder's short-notice rule.
  cancellationCharge   Boolean?
  notDeliveredReason   String?
  /// How a COMPLETED visit was completed. Null means from recorded attendance (every carer clocked in and out).
  /// OFFICE_CONFIRMED is the office's after-the-event confirmation that the care was delivered (Complete Calls): no clock,
  /// MAR or other evidence rows are created for it, and the times below are only what the office entered.
  completionSource     VisitCompletionSource?
  completionReason     String?
  /// Who confirmed the care was delivered (name and role, as the coordinator recorded it).
  completionVerifiedBy String?
  completedById        String?
  completedAt          DateTime?
  /// The status the visit had before the office completed it (for example MISSED). The full history is in VisitEvent.
  completedFromStatus  VisitStatus?
  rotaType             RotaType               @default(NORMAL)
  timeLocked           Boolean                @default(false)
  medicationRequired   Boolean                @default(false)
  alertOnLate          Boolean                @default(true)
  chargeable           Boolean                @default(true)
  payable              Boolean                @default(true)
  /// Changed by hand after it was built, so template changes never overwrite it.
  manuallyChanged      Boolean                @default(false)
  /// Carers can see the visit once it is published (builds publish automatically; drafts never reach the phone).
  publishedAt          DateTime?
  notes                String?
  lockVersion          Int                    @default(1)
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  assignments        VisitAssignment[]
  tasks              VisitTask[]
  clocks             VisitClock[]
  visitNotes         VisitNote[]
  events             VisitEvent[]
  taskOutcomes       VisitTaskOutcome[]
  correctionRequests ClockCorrectionRequest[]
  medicationLeads    VisitMedicationLead[]
  marRecords         MarRecord[]
  missedCallCase     MissedCallCase?
  /// Set on a recovery visit booked through Find Cover for a missed visit. The missed visit keeps its own status and history.
  recoveryOfId       String?
  recoveryOf         Visit?                   @relation("VisitRecovery", fields: [recoveryOfId], references: [id])
  recoveries         Visit[]                  @relation("VisitRecovery")
  coversBooked       MissedCallCover[]
  contactAttempts    CoverContactAttempt[]

  @@unique([organisationId, reference])
  @@index([organisationId, date])
  @@index([organisationId, status, date])
  @@index([serviceUserId, date])
  @@index([templateId, date])
  @@index([recoveryOfId])
}

/// PRIMARY is carer place 1, SECOND place 2, ADDITIONAL places 3 and above (numbered by VisitAssignment.position).
enum AssignmentSlot {
  PRIMARY
  SECOND
  SHADOW
  ADDITIONAL
}

/// A carer in one slot of a visit. Removing a carer keeps the row (removedAt) for history.
model VisitAssignment {
  id               String         @id @default(cuid())
  organisationId   String
  visitId          String
  visit            Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  slot             AssignmentSlot
  /// The carer place number: 1 (PRIMARY), 2 (SECOND), 3+ (ADDITIONAL), 0 for a shadow. Kept in step with slot by a database trigger.
  position         Int            @default(0)
  staffId          String
  staff            StaffMember    @relation(fields: [staffId], references: [id])
  /// Copied from the visit by a database trigger; used by the no-double-booking exclusion constraint.
  startsAt         DateTime
  endsAt           DateTime
  /// Maintained by trigger: true while this assignment occupies the carer's time.
  blocking         Boolean        @default(true)
  eligibility      String
  warningsAccepted String[]       @default([])
  assignedById     String
  assignedAt       DateTime       @default(now())
  acknowledgedAt   DateTime?
  removedAt        DateTime?
  removedById      String?
  removeReason     String?
  /// Set when an HR or absence change means this allocation must be reviewed by a coordinator.
  reviewReason     String?
  reviewFlaggedAt  DateTime?

  @@index([organisationId, staffId, startsAt])
  @@index([visitId])
}

model VisitTask {
  id         String             @id @default(cuid())
  visitId    String
  visit      Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  careTaskId String?
  name       String
  position   Int
  outcomes   VisitTaskOutcome[]

  @@index([visitId])
}

/// How a carer records each planned task. Every outcome other than DONE needs an explanation; CONCERN alerts the office.
enum TaskOutcome {
  DONE
  NOT_DONE
  REFUSED
  UNABLE
  NOT_APPLICABLE
  CONCERN
}

model VisitTaskOutcome {
  id             String      @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitTaskId    String
  visitTask      VisitTask   @relation(fields: [visitTaskId], references: [id], onDelete: Cascade)
  outcome        TaskOutcome
  note           String?
  staffId        String?
  recordedById   String
  at             DateTime    @default(now())

  @@index([visitId])
}

enum ClockKind {
  IN
  OUT
}

enum ClockMethod {
  APP
  APP_QR
  OFFICE
}

/// Append-only clock events (database trigger). Corrections are new rows that supersede earlier ones, with a reason.
model VisitClock {
  id             String      @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staffId        String?
  kind           ClockKind
  at             DateTime
  method         ClockMethod
  latitude       Float?
  longitude      Float?
  accuracyM      Float?
  /// One-time token from the device, so a replayed request is refused.
  nonce          String?     @unique
  recordedById   String
  reason         String?
  supersedesId   String?
  createdAt      DateTime    @default(now())

  @@index([visitId])
}

model VisitNote {
  id             String   @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  authorUserId   String
  staffId        String?
  category       String   @default("GENERAL")
  text           String
  createdAt      DateTime @default(now())

  @@index([visitId])
}

/// Append-only history of a visit: status changes, exceptions, office interventions.
model VisitEvent {
  id             String       @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type           String
  fromStatus     VisitStatus?
  toStatus       VisitStatus?
  actorId        String?
  reason         String?
  data           Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([visitId, createdAt])
}

enum RouteKind {
  CARER
  AREA
}

model RunRouteTemplate {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  kind           RouteKind @default(CARER)
  staffId        String?
  areaId         String?
  colour         String    @default("#6b46c9")
  textColour     String    @default("#ffffff")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([organisationId, name])
}

model RunRoute {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  kind           RouteKind @default(CARER)
  staffId        String?
  areaId         String?
  weekStart      DateTime  @db.Date
  colour         String    @default("#6b46c9")
  textColour     String    @default("#ffffff")
  templateId     String?
  createdById    String
  createdAt      DateTime  @default(now())
  visits         Visit[]

  @@unique([organisationId, weekStart, name])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// An operational alert for coordinators (late, missed, unassigned, HR impact). Resolved, never deleted.
model RotaAlert {
  id              String        @id @default(cuid())
  organisationId  String
  kind            String
  severity        AlertSeverity @default(WARNING)
  visitId         String?
  staffId         String?
  assignmentId    String?
  message         String
  dedupeKey       String        @unique
  raisedAt        DateTime      @default(now())
  /// When the condition first became true (for alert latency).
  conditionAt     DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?
  /// Exceptions register: who is dealing with it, by when, and whether it went to a manager.
  ownerId         String?
  ownerAssignedAt DateTime?
  deadline        DateTime?
  escalatedAt     DateTime?
  /// NONE | ESCALATED | RESOLVED_AFTER_ESCALATION
  escalationState String        @default("NONE")
  escalationNote  String?
  evidenceNote    String?

  @@index([organisationId, resolvedAt])
  @@index([organisationId, deadline])
  /// The Monitor's alert-speed figure reads alerts raised in the last day.
  @@index([organisationId, raisedAt])
}

/// One run of the call-monitoring sweep, so the monitor can show how fresh its figures are.
model RotaProcessingRun {
  id             String    @id @default(cuid())
  organisationId String?
  kind           String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  ok             Boolean   @default(false)
  processed      Int       @default(0)
  alertsRaised   Int       @default(0)
  error          String?

  @@index([kind, startedAt])
}

// ───────────────────────────── Finance ─────────────────────────────
// Money is integer pence. Approved runs are frozen by trigger; corrections are adjustment lines in a new run.

enum FunderKind {
  LOCAL_AUTHORITY
  NHS
  PRIVATE
  OTHER
}

enum TimeBasis {
  SCHEDULED
  ACTUAL
}

model Funder {
  id                     String        @id @default(cuid())
  organisationId         String
  name                   String
  kind                   FunderKind
  reference              String?
  billingEmail           String?
  billingAddress         String?
  paymentTermsDays       Int           @default(30)
  chargeBasis            TimeBasis     @default(SCHEDULED)
  chargeRateCardId       String?
  chargeRateCard         RateCard?     @relation(fields: [chargeRateCardId], references: [id])
  /// Cancellations within this many hours of the start are chargeable. Null: never.
  shortNoticeCancelHours Int?
  active                 Boolean       @default(true)
  createdAt              DateTime      @default(now())
  packages               CarePackage[]

  @@unique([organisationId, name])
}

enum RateCardKind {
  CHARGE
  PAY
}

model RateCard {
  id             String         @id @default(cuid())
  organisationId String
  kind           RateCardKind
  name           String
  effectiveFrom  DateTime       @db.Date
  effectiveTo    DateTime?      @db.Date
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  bands          RateBand[]
  funders        Funder[]
  staffRates     StaffPayRate[]

  @@unique([organisationId, name])
}

enum RateUnit {
  PER_HOUR
  PER_VISIT
}

model RateBand {
  id             String   @id @default(cuid())
  rateCardId     String
  rateCard       RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  label          String
  /// ISO weekdays this band applies to. Ignored for the bank-holiday band.
  weekdays       Int[]
  fromMinute     Int      @default(0)
  toMinute       Int      @default(1440)
  bankHoliday    Boolean  @default(false)
  ratePence      Int
  unit           RateUnit @default(PER_HOUR)
  minimumMinutes Int?
}

model BankHoliday {
  id             String   @id @default(cuid())
  organisationId String
  date           DateTime @db.Date
  name           String

  @@unique([organisationId, date])
}

model StaffPayRate {
  id             String      @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  rateCardId     String
  rateCard       RateCard    @relation(fields: [rateCardId], references: [id])
  effectiveFrom  DateTime    @db.Date
  effectiveTo    DateTime?   @db.Date

  @@index([organisationId, staffId])
}

model FinanceSettings {
  organisationId        String    @id
  defaultPayRateCardId  String?
  payBasis              TimeBasis @default(ACTUAL)
  mileagePencePerMile   Int       @default(45)
  invoicePrefix         String    @default("INV")
  nextInvoiceNumber     Int       @default(1)
  /// Employer on-costs (employer National Insurance, pension, holiday accrual) added to pay in rota cost estimates,
  /// as a whole percentage. An assumption set by the organisation; never used for payroll.
  estimateOnCostPercent Int       @default(0)
  updatedById           String?
  updatedAt             DateTime  @updatedAt
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Timesheet {
  id               String          @id @default(cuid())
  organisationId   String
  staffId          String
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  status           TimesheetStatus @default(DRAFT)
  scheduledMinutes Int             @default(0)
  deliveredMinutes Int             @default(0)
  payableMinutes   Int             @default(0)
  exceptions       Int             @default(0)
  mileageMiles     Float           @default(0)
  generatedById    String
  generatedAt      DateTime        @default(now())
  submittedById    String?
  submittedAt      DateTime?
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  version          Int             @default(1)
  lines            TimesheetLine[]

  @@unique([organisationId, staffId, periodStart, periodEnd])
}

model TimesheetLine {
  id               String    @id @default(cuid())
  timesheetId      String
  timesheet        Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  visitId          String?
  date             DateTime  @db.Date
  description      String
  scheduledMinutes Int
  deliveredMinutes Int
  payableMinutes   Int
  /// Why this line is not straightforward (no clock out, short visit, office-corrected…).
  exception        String?
  /// Attendance verification: a line with an exception is checked by the office before the timesheet is submitted.
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?
}

/// A request to correct a clock time. A carer's request is decided by someone else (database trigger); office
/// entries are recorded as approved requests (origin OFFICE) so every hand-entered time has one trail.
model ClockCorrectionRequest {
  id             String    @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staffId        String
  kind           ClockKind
  requestedTime  DateTime
  reason         String
  /// CARER | OFFICE
  origin         String    @default("CARER")
  /// PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  clockId        String?
  createdAt      DateTime  @default(now())

  @@index([organisationId, status])
  @@index([visitId])
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model MileageClaim {
  id             String      @id @default(cuid())
  organisationId String
  staffId        String
  visitId        String?
  date           DateTime    @db.Date
  miles          Float
  reason         String?
  status         ClaimStatus @default(SUBMITTED)
  submittedById  String
  submittedAt    DateTime    @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?

  @@index([organisationId, staffId, date])
}

enum RunStatusFinance {
  DRAFT
  APPROVED
  VOID
}

/// Invoice preparation. Approval needs a second person. Nothing is sent or issued by the platform.
model InvoiceRun {
  id             String           @id @default(cuid())
  organisationId String
  periodStart    DateTime         @db.Date
  periodEnd      DateTime         @db.Date
  status         RunStatusFinance @default(DRAFT)
  totalPence     Int              @default(0)
  exceptions     Json             @default("[]")
  createdById    String
  createdAt      DateTime         @default(now())
  approvedById   String?
  approvedAt     DateTime?
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  invoices       Invoice[]

  @@index([organisationId, periodStart])
}

model Invoice {
  id             String        @id @default(cuid())
  organisationId String
  runId          String
  run            InvoiceRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  funderId       String
  number         String?
  totalPence     Int
  dueDays        Int
  lines          InvoiceLine[]
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  visitId       String?
  serviceUserId String
  date          DateTime @db.Date
  description   String
  minutes       Int
  ratePence     Int
  amountPence   Int
  bandLabel     String
}

/// Payroll preparation. Approval needs a second person. Nothing is submitted or paid by the platform.
model PayRun {
  id             String           @id @default(cuid())
  organisationId String
  periodStart    DateTime         @db.Date
  periodEnd      DateTime         @db.Date
  status         RunStatusFinance @default(DRAFT)
  totalPence     Int              @default(0)
  exceptions     Json             @default("[]")
  createdById    String
  createdAt      DateTime         @default(now())
  approvedById   String?
  approvedAt     DateTime?
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  lines          PayLine[]

  @@index([organisationId, periodStart])
}

enum PayLineKind {
  VISIT
  MILEAGE
  ADJUSTMENT
}

model PayLine {
  id          String      @id @default(cuid())
  runId       String
  run         PayRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffId     String
  visitId     String?
  kind        PayLineKind
  date        DateTime    @db.Date
  description String
  minutes     Int
  ratePence   Int
  amountPence Int
  bandLabel   String
}

// ───────────────────────────── Staff readiness (training, competency, policy, restrictions) ─────────────────────────────
// Identity, employment and recruitment checks (DBS, right to work) stay in HR & Workforce and reach here through
// StaffCompliance. Everything below is keyed on StaffMember.id and evaluated by src/server/readiness. A status is never
// stored as the truth: it is worked out from these records every time, and every status cites them as evidence.

enum ReadinessCategory {
  TRAINING
  COMPETENCY
  POLICY
  QUALIFICATION
}

enum RequirementClassification {
  MANDATORY_ROLE
  AGENCY_POLICY
  CONTRACT
  RECOMMENDED
}

enum ReadinessScopeKind {
  ALL
  JOB_TITLE
  BRANCH
  CARE_TASK
  SERVICE_USER
}

enum RequirementStatus {
  ACTIVE
  RETIRED
}

/// One requirement in the organisation's training/competency/policy matrix. Versioned: a change retires this row and creates its successor.
model ReadinessRequirement {
  id                String                    @id @default(cuid())
  organisationId    String
  organisation      Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key               String
  name              String
  description       String?
  category          ReadinessCategory
  classification    RequirementClassification @default(MANDATORY_ROLE)
  sourceAuthority   String?
  sourceRef         String?
  sourceVersion     String?
  /// Course completion alone is not enough: an observed competency assessment is also required.
  requiresPractical Boolean                   @default(false)
  renewalMonths     Int?
  warningDays       Int                       @default(30)
  /// Not met = allocation is blocked (true) or flagged for review (false).
  hardStop          Boolean                   @default(true)
  /// Whether a manager may record a time-limited exception. Off for legal requirements.
  exceptionAllowed  Boolean                   @default(true)
  /// POLICY requirements: the policy whose current published version must be acknowledged.
  policyId          String?
  status            RequirementStatus         @default(ACTIVE)
  version           Int                       @default(1)
  supersedesId      String?
  effectiveFrom     DateTime                  @db.Date
  effectiveTo       DateTime?                 @db.Date
  createdById       String
  createdAt         DateTime                  @default(now())
  scopes            ReadinessScope[]
  records           StaffTrainingRecord[]
  assessments       CompetencyAssessment[]
  exceptions        ReadinessException[]

  @@unique([organisationId, key, version])
  @@index([organisationId, status])
}

/// Who a requirement applies to. Any matching scope applies. CARE_TASK and SERVICE_USER scopes are task-level: they bite when a visit involves that task or person.
model ReadinessScope {
  id            String               @id @default(cuid())
  requirementId String
  requirement   ReadinessRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          ReadinessScopeKind
  jobTitle      String?
  branchId      String?
  careTaskId    String?
  serviceUserId String?

  @@index([requirementId])
}

enum TrainingVerification {
  SUBMITTED
  VERIFIED
  REJECTED
}

/// A training completion, qualification or certificate for one requirement. Immutable once verified or rejected; a correction is a new row that supersedes it.
model StaffTrainingRecord {
  id                 String               @id @default(cuid())
  organisationId     String
  staffId            String
  staff              StaffMember          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  requirementId      String
  requirement        ReadinessRequirement @relation(fields: [requirementId], references: [id])
  provider           String?
  completedAt        DateTime             @db.Date
  expiresAt          DateTime?            @db.Date
  result             String?
  evidenceId         String?
  evidenceNote       String?
  assessmentType     String?
  assessor           String?
  enteredById        String
  verificationStatus TrainingVerification @default(SUBMITTED)
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNote   String?
  exemptionRationale String?
  supersedesId       String?
  createdAt          DateTime             @default(now())

  @@index([organisationId, staffId])
  @@index([requirementId])
}

enum AssessmentMethod {
  OBSERVED
  SIMULATED
  DISCUSSION
  WRITTEN
}

enum CompetencyOutcome {
  COMPETENT
  COMPETENT_WITH_RESTRICTIONS
  NOT_YET_COMPETENT
}

/// An observed or discussed practical competency assessment by a named assessor. Append-only; the latest decides.
model CompetencyAssessment {
  id               String               @id @default(cuid())
  organisationId   String
  staffId          String
  staff            StaffMember          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      ReadinessRequirement @relation(fields: [requirementId], references: [id])
  careTaskId       String?
  method           AssessmentMethod
  observedEvidence String
  assessorId       String
  assessorRole     String?
  outcome          CompetencyOutcome
  restrictions     String?
  remedialAction   String?
  assessedAt       DateTime             @db.Date
  reviewDue        DateTime?            @db.Date
  createdAt        DateTime             @default(now())

  @@index([organisationId, staffId])
}

enum RestrictionKind {
  TASK
  SERVICE_USER
  GENERAL
}

/// A limit on what a generally employed worker may do, with its reason. Lifted, never deleted.
model StaffRestriction {
  id             String          @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind           RestrictionKind
  careTaskId     String?
  serviceUserId  String?
  reason         String
  startsAt       DateTime        @db.Date
  endsAt         DateTime?       @db.Date
  createdById    String
  createdAt      DateTime        @default(now())
  liftedById     String?
  liftedAt       DateTime?
  liftedReason   String?

  @@index([organisationId, staffId])
}

/// A manager's time-limited exception to one requirement, with compensating controls. Never on requirements that forbid it.
model ReadinessException {
  id                   String               @id @default(cuid())
  organisationId       String
  staffId              String
  staff                StaffMember          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          ReadinessRequirement @relation(fields: [requirementId], references: [id])
  reason               String
  compensatingControls String
  approvedById         String
  expiresAt            DateTime             @db.Date
  createdAt            DateTime             @default(now())
  revokedById          String?
  revokedAt            DateTime?
  revokedReason        String?

  @@index([organisationId, staffId])
}

/// "Review required": a change that needs a manager to look again (role or branch change, long absence, incident, retired requirement). Cleared with an outcome, never deleted.
model StaffReadinessFlag {
  id             String      @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reason         String
  raisedById     String?
  raisedAt       DateTime    @default(now())
  clearedById    String?
  clearedAt      DateTime?
  outcome        String?

  @@index([organisationId, staffId, clearedAt])
}

/// The result of an evaluation at a point in time, kept so dashboards reconcile with history. Never the source of truth.
model StaffReadinessSnapshot {
  id             String      @id @default(cuid())
  organisationId String
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  evaluatedAt    DateTime    @default(now())
  status         String
  components     Json
  reasons        Json
  trigger        String

  @@index([organisationId, staffId, evaluatedAt])
}

// ───────────────────────────── Policy assignment and acknowledgement (Appendix E) ─────────────────────────────

enum PolicyAssignmentScope {
  ORG
  BRANCH
  ROLE
  JOB_TITLE
  STAFF
  /// Everyone who works in a branch: employed there, working in one of its areas, or recently visiting its service users.
  WORKS_IN_BRANCH
}

enum AcknowledgementState {
  ASSIGNED
  OPENED
  IN_PROGRESS
  ACKNOWLEDGED
  ASSESSMENT_REQUIRED
  ASSESSMENT_PASSED
  ASSESSMENT_FAILED
  EXEMPTED
  WITHDRAWN
}

/// Who must read and acknowledge a policy. Resolved to staff (HR projection) and their linked sign-ins; withdrawn with a reason, never deleted.
model PolicyAssignmentRule {
  id                 String                @id @default(cuid())
  organisationId     String
  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  policyId           String
  policy             Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  scope              PolicyAssignmentScope
  branchId           String?
  orgRole            OrgRole?
  jobTitle           String?
  staffMemberId      String?
  mandatory          Boolean               @default(true)
  /// 1 = high risk (overdue items escalate first), 3 = routine.
  priority           Int                   @default(2)
  dueDays            Int                   @default(14)
  /// After acknowledging, a manager-recorded knowledge check or discussion is required.
  requiresAssessment Boolean               @default(false)
  ownerId            String
  createdById        String
  createdAt          DateTime              @default(now())
  withdrawnAt        DateTime?
  withdrawnById      String?
  withdrawnReason    String?
  acknowledgements   Acknowledgement[]

  @@index([organisationId, policyId])
}

/// Append-only history of one acknowledgement: assigned, opened, reminded, escalated, acknowledged, assessed, exempted, withdrawn, corrected.
model AcknowledgementEvent {
  id                String          @id @default(cuid())
  organisationId    String
  acknowledgementId String
  acknowledgement   Acknowledgement @relation(fields: [acknowledgementId], references: [id], onDelete: Cascade)
  type              String
  actorId           String?
  note              String?
  data              Json?
  at                DateTime        @default(now())

  @@index([acknowledgementId, at])
  @@index([organisationId, type, at])
}

/// One-time link for joining an organisation (INVITE) or choosing a new password (RESET). Only the hash is stored;
/// the administrator gives the link to the person. Nothing is emailed.
model AccountToken {
  id             String        @id @default(cuid())
  /// Empty only for a platform-level account recovery link created by an Evantix platform administrator.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// INVITE | RESET
  kind           String
  email          String
  name           String?
  userId         String?
  roles          OrgRole[]    @default([])
  branchIds      String[]     @default([])
  jobTitle       String?
  tokenHash      String       @unique
  createdById    String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId, kind])
}

enum MedicationStatus {
  DRAFT
  ACTIVE
  STOPPED
}

enum MarOutcome {
  GIVEN
  PROMPTED
  REFUSED
  NOT_GIVEN
  NOT_REQUIRED
}

/// A medicine on a person's list. Used on visits only once a second person approves it (database trigger); a change
/// is a new medicine that replaces the old one, so the history stays.
model Medication {
  id             String                      @id @default(cuid())
  organisationId String
  serviceUserId  String
  serviceUser    ServiceUser                 @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  name           String
  strength       String?
  dose           String
  /// ORAL | TOPICAL | INHALED | EYE | EAR | NASAL | TRANSDERMAL | OTHER
  route          String
  /// PROMPT | ASSIST | ADMINISTER
  support        String
  /// MORNING | LUNCH | TEA | BED; empty for "as required" medicines.
  timeRanges     String[]                    @default([])
  asRequired     Boolean                     @default(false)
  maxDosesPerDay Int?
  controlled     Boolean                     @default(false)
  instructions   String?
  prescriber     String?
  startDate      DateTime                    @db.Date
  endDate        DateTime?                   @db.Date
  status         MedicationStatus            @default(DRAFT)
  createdById    String
  createdAt      DateTime                    @default(now())
  approvedById   String?
  approvedAt     DateTime?
  stoppedById    String?
  stoppedAt      DateTime?
  stopReason     String?
  replacesId     String?
  changeReason   String?
  records        MarRecord[]
  sites          MedicationApplicationSite[]

  @@index([organisationId, serviceUserId, status])
}

/// Who is responsible for medication on a visit. One live row per visit; a change ends the old row and adds a new one,
/// so the history stays. Ended by a database trigger when the carer leaves the visit, so responsibility never stays with
/// someone who is no longer booked. Responsibility is not evidence that medication was given: that is the MAR record.
model VisitMedicationLead {
  id             String      @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id])
  /// AUTO (the only carer, checked as competent) | COORDINATOR (chosen by an authorised coordinator)
  source         String
  assignedById   String
  assignedAt     DateTime    @default(now())
  reason         String?
  endedAt        DateTime?
  endedById      String?
  endReason      String?

  @@index([visitId])
  @@index([organisationId, staffId])
}

/// One recorded dose on a visit (append-only; a correction supersedes it with a reason).
model MarRecord {
  id             String     @id @default(cuid())
  organisationId String
  visitId        String
  visit          Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicationId   String
  medication     Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  staffId        String?
  outcome        MarOutcome
  reason         String?
  witnessName    String?
  recordedById   String
  at             DateTime   @default(now())
  supersedesId   String?
  supersededAt   DateTime?

  @@index([visitId])
  @@index([medicationId, at])
}

enum MissedCallStage {
  NEW
  INVESTIGATING
  AWAITING_SIGNOFF
  CLOSED
}

/// The investigation of one missed call. Opened automatically when a visit is marked missed, one per visit, never deleted.
model MissedCallCase {
  id                    String                         @id @default(cuid())
  organisationId        String
  visitId               String                         @unique
  visit                 Visit                          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Snapshot at detection: who was booked (null = nobody), for whom, where and when. Kept even if the rota changes later.
  staffId               String?
  serviceUserId         String
  areaId                String?
  callTypeId            String
  scheduledStart        DateTime
  detectedAt            DateTime                       @default(now())
  stage                 MissedCallStage                @default(NEW)
  deadline              DateTime?
  coordinatorId         String?
  coordinatorAssignedAt DateTime?
  reasonCode            String?
  reasonDetail          String?
  findings              String?
  reasonRecordedById    String?
  reasonRecordedAt      DateTime?
  /// REPLACEMENT_VISIT | CARER_ARRIVED_LATE | FAMILY_COVERED | CLIENT_DECLINED | NOT_NEEDED | NONE_POSSIBLE
  replacementType       String?
  replacementStaffId    String?
  replacementArrivedAt  DateTime?
  clientInformed        String?
  replacementNote       String?
  replacementWarnings   String[]                       @default([])
  replacementById       String?
  replacementAt         DateTime?
  escalatedAt           DateTime?
  escalatedById         String?
  escalationNote        String?
  outcome               String?
  outcomeNote           String?
  preventable           Boolean?
  submittedById         String?
  submittedAt           DateTime?
  signedOffById         String?
  signedOffAt           DateTime?
  signOffNote           String?
  reopenedAt            DateTime?
  reopenReason          String?
  /// Whether the service user or their representative has been told about the cover: INFORMED | REPRESENTATIVE_INFORMED | NOT_YET | COULD_NOT_REACH.
  suInformedStatus      String?
  suInformedNote        String?
  suInformedById        String?
  suInformedAt          DateTime?
  lockVersion           Int                            @default(1)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  actions               MissedCallAction[]
  comments              MissedCallComment[]
  covers                MissedCallCover[]
  contactAttempts       CoverContactAttempt[]
  carerConfirmations    MissedCallCarerConfirmation[]
  investigationRuns     MissedCallInvestigationRun[]
  investigationDrafts   MissedCallInvestigationDraft[]

  @@index([organisationId, scheduledStart])
  @@index([organisationId, stage])
  @@index([organisationId, staffId])
  @@index([organisationId, serviceUserId])
}

/// A follow-up action on a missed-call case, owned by a coordinator or manager.
model MissedCallAction {
  id             String         @id @default(cuid())
  organisationId String
  caseId         String
  case           MissedCallCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  text           String
  ownerId        String
  dueAt          DateTime
  doneAt         DateTime?
  doneById       String?
  createdById    String
  createdAt      DateTime       @default(now())

  @@index([organisationId, ownerId, doneAt])
  @@index([caseId])
}

/// A management comment or an evidence file on a missed-call case. Append-only.
model MissedCallComment {
  id             String         @id @default(cuid())
  organisationId String
  caseId         String
  case           MissedCallCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId       String
  /// COMMENT | EVIDENCE | SYSTEM
  kind           String         @default("COMMENT")
  body           String
  evidenceId     String?
  createdAt      DateTime       @default(now())

  @@index([caseId, createdAt])
}

enum RotaPlanStatus {
  DRAFT
  APPLIED
  DISCARDED
}

enum RotaPlanChangeKind {
  ASSIGN
  RETIME
}

enum RotaPlanDecision {
  PENDING
  ACCEPTED
  REJECTED
  APPLIED
  FAILED
}

/// A Generate & Optimise proposal for a date range. It never changes the rota by itself: the coordinator accepts or
/// rejects each change, and accepted changes are applied one by one through the normal assignment and edit paths.
model RotaPlan {
  id                  String           @id @default(cuid())
  organisationId      String
  fromDate            DateTime         @db.Date
  toDate              DateTime         @db.Date
  areaId              String?
  /// How gaps between visits are judged: TIME_GAP (a fixed minimum gap, no journey times).
  mode                String           @default("TIME_GAP")
  gapMinutes          Int
  maxShiftMinutes     Int
  respectWeeklyLimits Boolean          @default(true)
  status              RotaPlanStatus   @default(DRAFT)
  summary             Json             @default("{}")
  createdById         String
  createdAt           DateTime         @default(now())
  appliedById         String?
  appliedAt           DateTime?
  discardedById       String?
  discardedAt         DateTime?
  changes             RotaPlanChange[]

  @@index([organisationId, createdAt])
}

model RotaPlanChange {
  id               String             @id @default(cuid())
  organisationId   String
  planId           String
  plan             RotaPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  position         Int
  visitId          String
  kind             RotaPlanChangeKind
  slot             AssignmentSlot?
  /// The carer place number for ADDITIONAL slots (3+).
  slotPosition     Int?
  staffId          String?
  /// For RETIME: the visit's time when the plan was made and the proposed time.
  fromStart        DateTime?
  fromEnd          DateTime?
  toStart          DateTime?
  toEnd            DateTime?
  eligibility      String?
  score            Int?
  reasons          String[]           @default([])
  warnings         String[]           @default([])
  /// The visit's lockVersion when the plan was made; a visit changed since then is not touched.
  visitLockVersion Int
  decision         RotaPlanDecision   @default(PENDING)
  outcome          String?
  decidedById      String?
  decidedAt        DateTime?

  @@index([planId, position])
  @@index([organisationId, visitId])
}

/// One replacement carer booked through Find Cover for a missed call: the recovery visit and slot they were booked into,
/// what the eligibility service said at confirmation, which warnings the coordinator accepted and why, and whether the
/// carer was told in-app. Append-only; the visit and its assignment remain the authoritative booking.
model MissedCallCover {
  id                String                @id @default(cuid())
  organisationId    String
  caseId            String
  case              MissedCallCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// RECOVERY_VISIT: a new linked visit, because the original visit window has passed.
  method            String                @default("RECOVERY_VISIT")
  recoveryVisitId   String
  recoveryVisit     Visit                 @relation(fields: [recoveryVisitId], references: [id], onDelete: Cascade)
  slot              AssignmentSlot
  /// The carer place number for ADDITIONAL slots (3+).
  slotPosition      Int?
  assignmentId      String
  /// Who was booked on the missed visit (snapshot; null = nobody).
  originalStaffId   String?
  staffId           String
  proposedStart     DateTime
  proposedEnd       DateTime
  /// RECOMMENDED (one of the top three) or MANUAL (staff search).
  source            String
  recommendedRank   Int?
  /// The top three carers shown when cover was confirmed.
  suggestedStaffIds String[]              @default([])
  eligibility       String
  /// The safety checks as the server judged them at confirmation: [{label, state, text}].
  checks            Json                  @default("[]")
  warningsAccepted  String[]              @default([])
  warningReason     String?
  confirmedById     String
  confirmedAt       DateTime              @default(now())
  /// IN_APP: an in-app notification was created for the carer's linked sign-in. NO_SIGN_IN: the carer has no linked sign-in.
  notifyStatus      String
  notificationId    String?
  contactAttempts   CoverContactAttempt[]

  @@index([caseId])
  @@index([organisationId, staffId])
  @@index([recoveryVisitId])
}

/// One attempt to tell the service user (or someone acting for them) about cover arrangements, recorded from Find
/// Cover. Append-only: a database trigger refuses edits except closing the follow-up once. A correction is a new row
/// pointing at the original (correctsId), so the original stays. The recipient's name and the number or address used
/// are copied at the time, so later profile edits never rewrite history. Recording an SMS or e-mail does not mean the
/// platform sent one; nothing is sent from here.
model CoverContactAttempt {
  id                    String                @id @default(cuid())
  organisationId        String
  serviceUserId         String
  serviceUser           ServiceUser           @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  /// The visit whose arrangements were discussed (the recovery visit once one is booked).
  visitId               String
  visit                 Visit                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  missedCallCaseId      String?
  missedCallCase        MissedCallCase?       @relation(fields: [missedCallCaseId], references: [id], onDelete: Cascade)
  missedCallCoverId     String?
  missedCallCover       MissedCallCover?      @relation(fields: [missedCallCoverId], references: [id], onDelete: SetNull)
  /// SERVICE_USER | CONTACT | OTHER
  recipientKind         String
  contactId             String?
  contact               ServiceUserContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientName         String
  recipientRelationship String?
  /// The telephone number or address actually used, as it was at the time.
  recipientAddress      String?
  /// The recorded authority shown at the time (snapshot), if any.
  recipientAuthority    String?
  /// PHONE | SMS | EMAIL | OTHER
  method                String
  /// INFORMED | NO_ANSWER | MESSAGE_LEFT | UNSUCCESSFUL | NOT_APPLICABLE
  outcome               String
  notApplicableReason   String?
  notes                 String?
  /// The arrangements as they stood when this was recorded: carers, start and end. Compared with the visit now.
  arrangement           Json
  arrangementKey        String
  /// When the contact actually happened (may be earlier than createdAt).
  contactedAt           DateTime
  createdAt             DateTime              @default(now())
  createdById           String
  followUpRequired      Boolean               @default(false)
  followUpOwnerId       String?
  followUpDueAt         DateTime?
  followUpDoneAt        DateTime?
  followUpDoneById      String?
  followUpDoneNote      String?
  /// Set on a correction: the entry it corrects. The original is kept unchanged.
  correctsId            String?
  corrects              CoverContactAttempt?  @relation("AttemptCorrection", fields: [correctsId], references: [id], onDelete: Cascade)
  corrections           CoverContactAttempt[] @relation("AttemptCorrection")
  correctionReason      String?
  /// One per form submission, so a double click saves one entry.
  clientToken           String

  @@unique([organisationId, clientToken])
  @@index([organisationId, visitId, contactedAt])
  @@index([organisationId, followUpOwnerId, followUpDoneAt])
  @@index([missedCallCaseId])
  @@index([serviceUserId])
}

// ── Recruitment (HR & Workforce → Recruitment) ─────────────────────────────
// Candidates are not employees. A candidate becomes an employee only when HR authorises onboarding, which creates
// (or links) the HR Hub employee; rota eligibility still comes only from that employee's verified readiness.

enum RecruitmentStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  ONBOARDING
  READY
  WITHDRAWN
  UNSUCCESSFUL
}

enum RightToWorkStatus {
  NOT_CHECKED
  IN_PROGRESS
  VERIFIED
  NOT_ELIGIBLE
}

enum InterviewStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Candidate {
  id                   String               @id @default(cuid())
  organisationId       String
  /// CAN-0001, per organisation.
  reference            String
  firstName            String
  lastName             String
  email                String?
  phone                String?
  roleApplied          String
  /// The branch the candidate would work from. Access follows the HR account's branches.
  branchId             String
  availability         String?
  experience           String?
  /// DRIVER_WITH_CAR | DRIVER_NO_CAR | NON_DRIVER | NOT_ASKED
  driving              String               @default("NOT_ASKED")
  rightToWork          RightToWorkStatus    @default(NOT_CHECKED)
  /// Where the application came from, entered by hand (no job-board connection exists).
  source               String?
  stage                RecruitmentStage     @default(APPLIED)
  stageChangedAt       DateTime             @default(now())
  /// False while the application form is missing required details.
  applicationComplete  Boolean              @default(true)
  outstandingDocuments String[]             @default([])
  recruiterId          String?
  nextAction           String?
  nextActionDue        DateTime?            @db.Date
  /// The candidate agreed to be contacted about this application (the legal basis for any contact).
  contactConsent       Boolean              @default(false)
  consentRecordedAt    DateTime?
  offerMadeAt          DateTime?
  /// PENDING | ACCEPTED | DECLINED
  offerResponse        String?
  offerRespondedAt     DateTime?
  closedReason         String?
  closedAt             DateTime?
  /// Personal details may be removed after this date (unsuccessful or withdrawn applications).
  retainUntil          DateTime?            @db.Date
  anonymisedAt         DateTime?
  /// The HR Hub employee created or linked when onboarding was authorised.
  hrEmployeeId         String?
  convertedAt          DateTime?
  convertedById        String?
  lockVersion          Int                  @default(1)
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  events               CandidateEvent[]
  notes                CandidateNote[]
  screenings           CandidateScreening[]
  interviews           CandidateInterview[]

  @@unique([organisationId, reference])
  @@unique([organisationId, hrEmployeeId])
  @@index([organisationId, stage])
  @@index([organisationId, branchId])
}

/// What happened to a candidate and who did it. Holds no free-text personal data, so it survives anonymisation.
model CandidateEvent {
  id             String            @id @default(cuid())
  organisationId String
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type           String
  fromStage      RecruitmentStage?
  toStage        RecruitmentStage?
  actorId        String
  at             DateTime          @default(now())
  data           Json              @default("{}")

  @@index([candidateId, at])
}

model CandidateNote {
  id             String    @id @default(cuid())
  organisationId String
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  text           String
  authorId       String
  createdAt      DateTime  @default(now())

  @@index([candidateId])
}

/// Structured screening questions given to a candidate, and the answers recorded by the recruiter.
model CandidateScreening {
  id             String    @id @default(cuid())
  organisationId String
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// [{ key, question }]
  questions      Json
  /// [{ key, answer }] once recorded.
  answers        Json?
  /// How the questions were given: PHONE | IN_PERSON | PAPER. No message is sent by the platform.
  channel        String
  sentAt         DateTime  @default(now())
  sentById       String
  answeredAt     DateTime?
  recordedById   String?
  /// PROCEED | HOLD, decided by a person.
  reviewOutcome  String?
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?

  @@index([candidateId])
}

model CandidateInterview {
  id             String          @id @default(cuid())
  organisationId String
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  durationMin    Int             @default(45)
  location       String?
  interviewerId  String
  status         InterviewStatus @default(AWAITING_CONFIRMATION)
  confirmedAt    DateTime?
  notes          String?
  /// PASSED | NOT_PASSED, recorded by a person.
  outcome        String?
  outcomeAt      DateTime?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId, startsAt])
  @@index([candidateId])
}

/// When recruitment reminders appear for the assigned recruiter (in the app only; nothing is sent to candidates).
model RecruitmentSettings {
  organisationId          String   @id
  remindersOn             Boolean  @default(true)
  incompleteAfterDays     Int      @default(3)
  screeningAfterDays      Int      @default(3)
  interviewConfirmHours   Int      @default(48)
  referencesAfterDays     Int      @default(7)
  onboardingDocsAfterDays Int      @default(5)
  trainingAfterDays       Int      @default(7)
  /// How long an unsuccessful or withdrawn application is kept before personal details may be removed.
  retentionMonths         Int      @default(6)
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

// ── Care Summary (Care Plans → Care Summary) ───────────────────────────────

/// A summary of a person's recorded care for a period. Provenance is stored with it; it never changes a care record.
model CareSummary {
  id             String    @id @default(cuid())
  organisationId String
  serviceUserId  String
  fromDate       DateTime  @db.Date
  toDate         DateTime  @db.Date
  /// anthropic | simulated
  provider       String
  model          String?
  isSimulated    Boolean   @default(false)
  requestedById  String
  createdAt      DateTime  @default(now())
  /// The records sent to the summariser: [{ id, kind }].
  sources        Json
  /// The validated output (every point cites source ids from `sources`).
  output         Json
  /// UNREVIEWED | REVIEWED | DISMISSED
  status         String    @default("UNREVIEWED")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?

  @@index([organisationId, serviceUserId, createdAt])
}

// ── Service user documents and Digital Body Map ─────────────────────────────

/// Private file bytes, used as the storage provider on hosts without a writable disk (Vercel). Keys are opaque and
/// carry the organisation; rows are only read by the storage layer after the caller's permission checks.
model StoredObject {
  key         String   @id
  contentType String
  sizeBytes   Int
  bytes       Bytes
  createdAt   DateTime @default(now())
}

/// Council Documents and Other Documents are two separate profile sections sharing this table.
enum ServiceUserDocumentSection {
  COUNCIL
  OTHER
}

/// A document held on a service user's record. The file itself lives in versions: replacing adds a version and never
/// deletes an earlier one. Archiving moves it to "Historical documents"; nothing is ever deleted.
model ServiceUserDocument {
  id               String                       @id @default(cuid())
  organisationId   String
  serviceUserId    String
  serviceUser      ServiceUser                  @relation(fields: [serviceUserId, organisationId], references: [id, organisationId], onDelete: Cascade)
  section          ServiceUserDocumentSection
  /// A key from the section's category list (src/server/care/su-documents.ts).
  category         String
  name             String
  issuingAuthority String?
  receivedOn       DateTime?                    @db.Date
  effectiveFrom    DateTime?                    @db.Date
  expiresOn        DateTime?                    @db.Date
  notes            String?
  /// Sensitive documents (ID, medical, financial, or marked so) open only with serviceUser.sensitive.
  sensitive        Boolean                      @default(false)
  currentVersion   Int                          @default(1)
  archivedAt       DateTime?
  archivedById     String?
  archiveReason    String?
  createdById      String
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  /// Optimistic concurrency for detail edits and replacements.
  lockVersion      Int                          @default(1)
  versions         ServiceUserDocumentVersion[]

  @@index([organisationId, serviceUserId, section])
}

/// One uploaded file of a document. Rows are never edited (database trigger).
model ServiceUserDocumentVersion {
  id             String              @id @default(cuid())
  organisationId String
  documentId     String
  document       ServiceUserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int
  filename       String
  contentType    String
  sizeBytes      Int
  sha256         String
  storageKey     String
  /// CLEAN | NOT_SCANNED (same policy as compliance evidence; INFECTED files are never stored).
  scanStatus     String
  changeNote     String?
  uploadedById   String
  uploadedAt     DateTime            @default(now())
  /// Dates written on or given for this version (set once when it is added).
  documentDate   DateTime?           @db.Date
  receivedOn     DateTime?           @db.Date
  effectiveFrom  DateTime?           @db.Date
  /// The Care Coordinator intake this version came from, if any.
  intakeId       String?
  statuses       ServiceUserDocumentVersionStatus[]

  @@unique([documentId, version])
}

/// A version's status over time, append-only (database trigger): PENDING_REVIEW | CURRENT | SUPERSEDED | WITHDRAWN |
/// REJECTED. The latest row is the version's status; a version with no rows predates version control.
model ServiceUserDocumentVersionStatus {
  id             String                     @id @default(cuid())
  organisationId String
  documentId     String
  versionId      String
  version        ServiceUserDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status         String
  note           String?
  actorId        String
  at             DateTime                   @default(now())

  @@index([documentId, at])
}

enum BodyMapView {
  FRONT
  BACK
  LEFT
  RIGHT
}

enum BodyMapStatus {
  /// Recorded; follow-up or a manager's review may still be due.
  OPEN
  /// A reviewer recorded a final outcome.
  RESOLVED
}

/// A physical observation marked on the body map. What was observed is kept exactly as first recorded (database
/// trigger); follow-ups, reviews and the incident decision are added on top.
model BodyMapObservation {
  id                   String                     @id @default(cuid())
  organisationId       String
  serviceUserId        String
  serviceUser          ServiceUser                @relation(fields: [serviceUserId, organisationId], references: [id, organisationId], onDelete: Cascade)
  view                 BodyMapView
  /// Position of the mark on the outline, as a percentage of its width and height.
  x                    Float
  y                    Float
  /// The named body area (from the region list), e.g. "Left forearm".
  region               String
  locationDetail       String?
  category             String
  observedAt           DateTime
  description          String
  size                 String?
  appearance           String?
  /// NONE | MILD | MODERATE | SEVERE | NOT_ABLE_TO_SAY
  pain                 String
  actionTaken          String?
  personNotified       String?
  followUpOn           DateTime?                  @db.Date
  status               BodyMapStatus              @default(OPEN)
  recordedById         String
  recordedAt           DateTime                   @default(now())
  /// The manager's decision on whether an incident report is needed: LINKED | NOT_REQUIRED (null = not decided).
  incidentDecision     String?
  incidentDecisionNote String?
  incidentDecidedById  String?
  incidentDecidedAt    DateTime?
  incidentId           String?
  incident             Incident?                  @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  version              Int                        @default(1)
  /// The manager assigned to review the observation (bodyMap.review). Can be changed; each change is audited.
  reviewerId           String?
  reviews              BodyMapReview[]
  photos               BodyMapPhoto[]
  notes                BodyMapNote[]
  recommendationRuns   BodyMapRecommendationRun[]
  recommendations      BodyMapRecommendation[]
  tasks                BodyMapTask[]

  @@index([organisationId, serviceUserId, observedAt])
  @@index([organisationId, status, followUpOn])
}

/// A follow-up or review of an observation. Append-only.
model BodyMapReview {
  id             String             @id @default(cuid())
  organisationId String
  observationId  String
  observation    BodyMapObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  reviewedAt     DateTime           @default(now())
  reviewedById   String
  outcome        String
  /// The next follow-up date set by this review (null when resolved or none needed).
  nextFollowUpOn DateTime?          @db.Date
  resolved       Boolean            @default(false)
}

/// A photograph of an observation, held in private storage. Rows are never edited.
model BodyMapPhoto {
  id             String             @id @default(cuid())
  organisationId String
  observationId  String
  observation    BodyMapObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  filename       String
  contentType    String
  sizeBytes      Int
  sha256         String
  storageKey     String
  /// CLEAN | NOT_SCANNED
  scanStatus     String
  caption        String?
  /// The note this photograph was added with, if any.
  noteId         String?
  uploadedById   String
  uploadedAt     DateTime           @default(now())
}

/// A manual note or update on an observation ("Reviewed today, bruising smaller…"). Append-only: the original
/// observation and earlier notes are never changed.
model BodyMapNote {
  id             String             @id @default(cuid())
  organisationId String
  observationId  String
  observation    BodyMapObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  authorId       String
  text           String
  createdAt      DateTime           @default(now())

  @@index([observationId, createdAt])
}

/// One request for AI-Assisted Recommendations on an observation: what was sent (record ids only, never photos or
/// names), which provider answered, and the outcome. `basisHash` identifies the information used, so the same
/// information is never sent twice; a later run on updated information supersedes earlier ones without changing them.
model BodyMapRecommendationRun {
  id                 String                  @id @default(cuid())
  organisationId     String
  observationId      String
  observation        BodyMapObservation      @relation(fields: [observationId], references: [id], onDelete: Cascade)
  /// AUTO (after the observation was saved) | MANUAL (Generate recommendations)
  trigger            String
  basisHash          String
  observationVersion Int
  provider           String
  model              String?
  isSimulated        Boolean                 @default(false)
  /// COMPLETED | NONE (no reliable recommendation) | FAILED
  status             String
  error              String?
  /// What the records do not show, or what could not be considered.
  gaps               Json                    @default("[]")
  /// The records considered: [{ sid, kind, id, label, href }].
  sources            Json                    @default("[]")
  requestedById      String
  createdAt          DateTime                @default(now())
  supersededAt       DateTime?
  recommendations    BodyMapRecommendation[]

  @@index([observationId, createdAt])
}

/// One AI-assisted suggestion. Its text is kept exactly as shown to the reviewer (database trigger); only its review
/// status moves on. Accepting a suggestion is not a clinical or safeguarding decision.
model BodyMapRecommendation {
  id                String                   @id @default(cuid())
  organisationId    String
  observationId     String
  observation       BodyMapObservation       @relation(fields: [observationId], references: [id], onDelete: Cascade)
  runId             String
  run               BodyMapRecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position          Int
  /// OBSERVATION_FOLLOW_UP | CARE_PLAN_REVIEW | RISK_REVIEW | INCIDENT_SAFEGUARDING | MEDICATION_REVIEW | HISTORICAL_COMPARISON
  category          String
  title             String
  explanation       String
  suggestedAction   String
  /// The follow-up task a manager may create from it: FOLLOW_UP | CARE_PLAN_REVIEW | RISK_REVIEW | INCIDENT_ASSESSMENT | MANAGER_REVIEW
  actionKind        String?
  /// Recorded facts the suggestion relies on, kept apart from the interpretation.
  facts             Json                     @default("[]")
  /// Supporting records and approved policies: [{ sid, kind, label, href }].
  sources           Json                     @default("[]")
  /// NEW | UNDER_REVIEW | ACCEPTED | DISMISSED | ACTION_CREATED
  status            String                   @default("NEW")
  reviewStartedById String?
  reviewStartedAt   DateTime?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  taskId            String?
  createdAt         DateTime                 @default(now())

  @@index([organisationId, status])
  @@index([observationId])
}

/// A follow-up task from the body map (often from an accepted recommendation): a follow-up, a care plan or risk
/// assessment review request, an incident assessment request or a manager review. Assigned to one person.
model BodyMapTask {
  id               String             @id @default(cuid())
  organisationId   String
  serviceUserId    String
  observationId    String
  observation      BodyMapObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  recommendationId String?
  /// FOLLOW_UP | CARE_PLAN_REVIEW | RISK_REVIEW | INCIDENT_ASSESSMENT | MANAGER_REVIEW
  kind             String
  title            String
  details          String?
  assigneeId       String
  dueOn            DateTime           @db.Date
  /// OPEN | DONE | CANCELLED
  status           String             @default("OPEN")
  createdById      String
  createdAt        DateTime           @default(now())
  closedById       String?
  closedAt         DateTime?
  outcome          String?
  version          Int                @default(1)

  @@index([organisationId, status, dueOn])
  @@index([observationId])
}

/// Where on the body a topical medicine or patch is applied, as documented by a manager. Not a skin observation and
/// never a record that a dose was given (that is the MAR). A cream may have several sites; a new patch site ends the
/// previous one. Sites are ended, never deleted, so the history stays.
model MedicationApplicationSite {
  id             String      @id @default(cuid())
  organisationId String
  serviceUserId  String
  medicationId   String
  medication     Medication  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  view           BodyMapView
  x              Float
  y              Float
  region         String
  note           String?
  recordedById   String
  recordedAt     DateTime    @default(now())
  endedAt        DateTime?
  endedById      String?
  endReason      String?

  @@index([organisationId, serviceUserId])
  @@index([medicationId])
}

/// Restricted follow-up queue for things a person must check after a Care Coordinator intake: medication
/// reconciliation, historical incidents and skin findings, risk questions, missing information. Never a medication
/// order, an incident or a body map observation in itself.
/// category: MEDICATION | INCIDENT_HISTORY | BODY_MAP | RISK | CLINICAL | MISSING_INFO | FIELD_MAPPING
/// status: OPEN | RESOLVED | REVIEWED
model CareIntakeReviewItem {
  id             String      @id @default(cuid())
  organisationId String
  serviceUserId  String
  serviceUser    ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  /// The intake and fact it came from (null for items made by hand or before intakes existed).
  intakeId       String?
  factId         String?
  category       String
  description    String
  sourceRef      String?
  /// True when the source is a restricted document or the item is clinical: shown only with serviceUser.sensitive.
  restricted     Boolean     @default(true)
  status         String      @default("OPEN")
  assignedToId   String?
  createdById    String
  createdAt      DateTime    @default(now())
  resolvedById   String?
  resolvedAt     DateTime?
  resolution     String?
  /// Automatic setup (7 Nov 2026): INFO | FOLLOW_UP | REVIEW | URGENT. Null for items made before it, which take their
  /// category's usual severity (exceptionSeverity in coordinator-triage.ts).
  severity       String?
  /// A short heading, e.g. "Two dates of birth". Null for older items (the category label is shown instead).
  title          String?
  /// The profile tab where the record to correct lives (details, people, package, care-plans, risks, template...).
  recordTab      String?
  /// True when CSB AI raised it during automatic setup (the person who started the intake is createdById).
  automated      Boolean     @default(false)

  @@unique([factId])
  @@index([organisationId, serviceUserId, status])
}

/// AI Care Coordinator intake: the documents for one person, every fact read from them with its page, the
/// coordinator's decision on each fact, the manager's decision on each profile section and what was applied.
/// status: DRAFT | SUBMITTED | APPROVED | APPLYING | COMPLETED | CANCELLED
model CareIntake {
  id               String               @id @default(cuid())
  organisationId   String
  reference        String
  /// What the office calls this intake until a person exists, e.g. "New referral, Stepney".
  title            String
  status           String               @default("DRAFT")
  /// The existing person this intake updates, or the person it created.
  serviceUserId    String?
  /// NEW: set up a new person. EXISTING: compare with and update serviceUserId.
  mode             String               @default("NEW")
  areaId           String?
  /// Who or what read the documents: the AI provider's name, "basic-reader" (no AI) or "manual".
  reader           String?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  /// Since 7 Nov 2026: the coordinator who last pressed Approve & Save to CRM. Before: who sent it to a manager.
  submittedById    String?
  submittedAt      DateTime?
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  /// Who confirmed that a possible match already on record is a different person (null = not confirmed).
  notDuplicateById String?
  /// Automatic setup by CSB AI (7 Nov 2026): PROCESSING | READY | NEEDS_ATTENTION | FAILED, null when it never ran.
  setupStatus      String?
  /// The last stage that finished (TRIAGE, IDENTITY, RECORDS, ROTA, EXCEPTIONS, VERIFIED), so a retry carries on.
  setupStage       String?
  setupStartedAt   DateTime?
  setupFinishedAt  DateTime?
  /// Who started the automatic setup (the person whose upload or "Run automatic setup" began it).
  setupById        String?
  /// The read-back summary: counts from the database, the sections, the rota, identity questions and failures.
  setupReport      Json?
  lockVersion      Int                  @default(1)
  documents        CareIntakeDocument[]
  facts            CareIntakeFact[]
  sections         CareIntakeSection[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
}

/// One uploaded document. The original file is stored privately and never changed; the page text is kept so every
/// fact can be checked against the page it came from.
/// readStatus: PENDING | READ | PARTLY_READ | UNREADABLE | FAILED
model CareIntakeDocument {
  id              String                     @id @default(cuid())
  organisationId  String
  intakeId        String
  intake          CareIntake                 @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  position        Int
  filename        String
  contentType     String
  sizeBytes       Int
  sha256          String
  storageKey      String
  scanStatus      String
  /// Where it will be filed: COUNCIL or OTHER, and a category key from su-documents.ts.
  section         ServiceUserDocumentSection
  category        String
  name            String
  issuer          String?
  /// COUNCIL | NHS | GP | FAMILY | OTHER
  issuerKind      String?
  documentDate    DateTime?                  @db.Date
  sensitive       Boolean                    @default(false)
  pageCount       Int?
  /// One string per page from the PDF's text layer (empty for scanned pages).
  pageText        Json                       @default("[]")
  readStatus      String                     @default("PENDING")
  readNote        String?
  /// Who last read it: ai | basic-reader | ai-and-basic (the basic reader covered pages the AI could not read).
  readMethod      String?
  /// Why the AI could not read it (or some of its pages) last time, as a safe category such as busy or timeout.
  readFailure     String?
  readAt          DateTime?
  /// Background reading (6 Nov 2026): QUEUED | READING | PREPARING | RETRYING | DONE | FAILED, null for documents
  /// read before reading moved to the job queue.
  readStage       String?
  readStageAt     DateTime?
  /// The BackgroundJob reading it, so a second "Read again" joins the job in progress instead of starting another.
  readJobId       String?
  /// What the last stage said in plain words (the preparation report, or why it is waiting or failed).
  readStageNote   String?
  /// What the reading found that is not a fact: [{ kind: "FLAG" | "MISSING" | "UNREADABLE", text, page }].
  findings        Json                       @default("[]")
  /// The Council/Other Documents record this was filed as, once applied.
  filedDocumentId String?
  createdById     String
  createdAt       DateTime                   @default(now())

  @@index([intakeId])
}

/// One fact read from a document (or added by hand), where it goes in the profile, and the coordinator's decision.
/// section: PERSONAL | CONTACTS | CARER_PREFERENCES | CARE_PLAN | RISKS | PACKAGE | MEDICATION | INCIDENTS | BODY_MAP | VISITS
/// decision: PENDING | APPROVED | EDITED | REJECTED | CLARIFY | DUPLICATE
/// verification: VERIFIED (quote found on the page) | UNVERIFIED | MANUAL
/// temporal: CURRENT | HISTORICAL | UNKNOWN
model CareIntakeFact {
  id               String     @id @default(cuid())
  organisationId   String
  intakeId         String
  intake           CareIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  section          String
  /// The exact destination, e.g. "person.postcode", "careplan.mobility", "visit", "risk", "contact".
  destination      String
  label            String
  position         Int        @default(0)
  /// What was read, never changed. value is what will be saved (equal to proposed unless edited).
  proposed         Json
  value            Json
  sourceDocumentId String?
  sourcePage       Int?
  quote            String?
  verification     String     @default("UNVERIFIED")
  temporal         String     @default("CURRENT")
  /// AI | BASIC | MANUAL
  origin           String     @default("AI")
  existingValue    Json?
  conflict         String?
  decision         String     @default("PENDING")
  decisionNote     String?
  question         String?
  assignedToId     String?
  decidedById      String?
  decidedAt        DateTime?
  /// HUMAN: decidedById made the decision. AUTOMATION: CSB AI decided it during automatic setup that decidedById
  /// started; it is never shown as that person's review.
  decisionSource   String     @default("HUMAN")
  editedById       String?
  editedAt         DateTime?
  appliedAt        DateTime?
  /// What the fact became: "ServiceUserContact:<id>", "VisitTemplate:<id>" and so on.
  appliedRef       String?
  lockVersion      Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([intakeId, section])
}

/// The coordinator's approval of one profile section of an intake, and whether it has been saved to the CRM.
/// status: OPEN | APPROVED | DRAFTED | REJECTED (RETURNED / INFO_REQUESTED only from the retired manager step)
/// decidedById: the coordinator who approved the section (Approve & Save to CRM, 7 Nov 2026).
/// applyStatus: NOT_STARTED | SAVING | DONE | FAILED | BLOCKED; claimedAt is when the current save started.
model CareIntakeSection {
  id             String     @id @default(cuid())
  organisationId String
  intakeId       String
  intake         CareIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  section        String
  status         String     @default("OPEN")
  reason         String?
  decidedById    String?
  decidedAt      DateTime?
  applyStatus    String     @default("NOT_STARTED")
  applyResult    Json?
  applyError     String?
  appliedById    String?
  appliedAt      DateTime?
  attempts       Int        @default(0)
  claimedAt      DateTime?
  lockVersion    Int        @default(1)

  @@unique([intakeId, section])
}

/// One row per carer booked on a missed visit, written when the case opens (the booked-carer snapshot), so a later rota
/// change cannot rewrite who was booked. It also carries the in-app request asking that carer what happened.
/// status: NOT_REQUESTED | NO_LOGIN | REQUESTED | RESPONDED | NO_RESPONSE | WITHDRAWN
model MissedCallCarerConfirmation {
  id                   String                    @id @default(cuid())
  organisationId       String
  caseId               String
  case                 MissedCallCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staffId              String
  staff                StaffMember               @relation(fields: [staffId], references: [id])
  assignmentId         String
  slot                 AssignmentSlot
  position             Int                       @default(0)
  /// The sign-in linked to the staff record when the call was missed (null = none).
  userIdAtDetection    String?
  status               String                    @default("NOT_REQUESTED")
  requestedAt          DateTime?
  notificationId       String?
  /// Copied from the notification when it is first opened. Not proof the request was read.
  notificationOpenedAt DateTime?
  responseDueAt        DateTime?
  remindersSent        Int                       @default(0)
  lastReminderAt       DateTime?
  overdueNotifiedAt    DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  responses            MissedCallCarerResponse[]

  @@unique([caseId, staffId])
  @@index([organisationId, staffId, status])
  @@index([status, responseDueAt])
}

/// A carer's own statement about a missed visit. Append-only (database trigger): a correction or addition is a new row
/// pointing at the one it supplements. These are what the carer reported, not investigation findings.
model MissedCallCarerResponse {
  id                String                      @id @default(cuid())
  organisationId    String
  confirmationId    String
  confirmation      MissedCallCarerConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  staffId           String
  authorUserId      String
  /// ATTENDED_NO_CLOCK | ARRIVED_LATE | UNABLE_TO_ATTEND | ACCESS_PROBLEM | SU_CANCELLED | PHONE_SYSTEM | ROTA_WRONG | OTHER
  answer            String
  reportedArrival   DateTime?
  reportedDeparture DateTime?
  /// YES | PARTLY | NO, as reported by the carer.
  careDelivered     String?
  /// Unable to attend: SICKNESS | TRAVEL | OTHER
  unableReason      String?
  notifiedSomeone   Boolean?
  notifiedWho       String?
  notifiedAt        DateTime?
  attemptedAt       DateTime?
  contacted         String?
  explanation       String
  supplementsId     String?
  submissionKey     String                      @unique
  submittedAt       DateTime                    @default(now())

  @@index([confirmationId, submittedAt])
}

/// One evidence collection for a missed call: what the system held at that moment, as a frozen snapshot of ids, times
/// and statuses (no note text, addresses or medication names). An unchanged fingerprint is recorded as UNCHANGED.
/// status: RUNNING | COMPLETED | UNCHANGED | FAILED
model MissedCallInvestigationRun {
  id                String                         @id @default(cuid())
  organisationId    String
  caseId            String
  case              MissedCallCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// DETECTED | CLOCK | CORRECTION | CARER_RESPONSE | ROTA_CHANGE | COVER | MANUAL | CATCH_UP
  reason            String
  status            String                         @default("RUNNING")
  requestedById     String?
  jobId             String?
  startedAt         DateTime                       @default(now())
  finishedAt        DateTime?
  evidence          Json                           @default("[]")
  timeline          Json                           @default("[]")
  sourceRefs        Json                           @default("[]")
  fingerprint       String?
  error             String?
  processingVersion Int                            @default(1)
  drafts            MissedCallInvestigationDraft[]

  @@index([caseId, startedAt])
}

/// The rules-based suggestion made from one run, and the coordinator's decision on it. A suggestion never becomes the
/// case's reason by itself: accepting it records the reason through the normal investigation step.
/// reviewStatus: PENDING | ACCEPTED | DIFFERENT_REASON | DISMISSED | SUPERSEDED
model MissedCallInvestigationDraft {
  id              String                     @id @default(cuid())
  organisationId  String
  caseId          String
  case            MissedCallCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  runId           String
  run             MissedCallInvestigationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  suggestedReason String?
  classification  String
  /// SUPPORTED | WEAK | INSUFFICIENT
  support         String
  summary         Json
  generator       String                     @default("rules-v1")
  reviewStatus    String                     @default("PENDING")
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime                   @default(now())

  @@index([caseId, createdAt])
}

// ───────────────────────── CQC Inspection & Evidence + Root Cause Analysis
// An internal readiness tool. Nothing here is an official CQC rating, and nothing is sent to CQC.

enum CqcKeyQuestion {
  SAFE
  EFFECTIVE
  CARING
  RESPONSIVE
  WELL_LED
}

/// A versioned mapping of management assessment areas to CQC's published framework and the regulations. Shared by every
/// organisation (read-only to them). A new CQC framework is a new version; assessments keep the version they used.
model CqcFramework {
  id              String          @id @default(cuid())
  version         String          @unique
  title           String
  /// DRAFT | ACTIVE | RETIRED. New assessments use the ACTIVE version.
  status          String          @default("ACTIVE")
  /// What the mapping is based on, in words, and where to check it.
  basis           String
  sourceUrl       String?
  /// When someone last checked the mapping against the published source. Null = not yet checked.
  sourceCheckedAt DateTime?
  notes           String?
  effectiveFrom   DateTime        @db.Date
  createdAt       DateTime        @default(now())
  criteria        CqcCriterion[]
  assessments     CqcAssessment[]
}

/// One assessment area under a key question, with the quality statement and regulations it maps to.
model CqcCriterion {
  id               String                @id @default(cuid())
  frameworkId      String
  framework        CqcFramework          @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code             String
  keyQuestion      CqcKeyQuestion
  title            String
  qualityStatement String
  regulations      String[]
  guidance         String
  evidenceExamples String[]
  /// Words used to suggest existing records as possible evidence (never to verify them).
  keywords         String[]
  /// Which kinds of record the automatic discovery looks at for this area.
  discoveryKinds   String[]
  /// Essential areas raise a "missing essential evidence" warning when they have no verified evidence.
  essential        Boolean               @default(false)
  position         Int
  results          CqcAssessmentResult[]
  evidenceLinks    CqcEvidenceLink[]
  actions          ComplianceAction[]

  @@unique([frameworkId, code])
}

model CqcAssessment {
  id                String                 @id @default(cuid())
  organisationId    String
  /// CQC-2026-0001, unique in the organisation.
  reference         String
  title             String
  /// Null = the whole organisation.
  branchId          String?
  /// A configured service type (ServiceType.code), or null for every service.
  serviceTypeCode   String?
  frameworkId       String
  framework         CqcFramework           @relation(fields: [frameworkId], references: [id])
  periodFrom        DateTime               @db.Date
  periodTo          DateTime               @db.Date
  /// IN_PROGRESS | AWAITING_APPROVAL | APPROVED | SUPERSEDED
  status            String                 @default("IN_PROGRESS")
  assessorId        String
  managementComment String?
  nextDueAt         DateTime?              @db.Date
  submittedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  returnedReason    String?
  /// The assessment this one was started from (results copied as a starting point).
  previousId        String?
  lockVersion       Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  results           CqcAssessmentResult[]
  snapshots         CqcReadinessSnapshot[]
  actions           ComplianceAction[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, branchId])
}

/// The current result for one criterion in one assessment. Every change is kept in the audit log with old and new values.
model CqcAssessmentResult {
  id             String        @id @default(cuid())
  organisationId String
  assessmentId   String
  assessment     CqcAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId    String
  criterion      CqcCriterion  @relation(fields: [criterionId], references: [id])
  /// MET | PARTIALLY_MET | NOT_MET | NOT_APPLICABLE
  result         String
  rationale      String
  findings       String?
  /// Required when the result is NOT_APPLICABLE.
  naReason       String?
  recordedById   String
  recordedAt     DateTime      @default(now())
  version        Int           @default(1)

  @@unique([assessmentId, criterionId])
}

/// A record offered as evidence for a criterion. The record itself stays where it is (evidence library, training,
/// audits, RCA...); this row only says which criterion it may support and whether a reviewer has verified it.
model CqcEvidenceLink {
  id             String       @id @default(cuid())
  organisationId String
  criterionId    String
  criterion      CqcCriterion @relation(fields: [criterionId], references: [id])
  /// The branch the source record belongs to (null = organisation-wide).
  branchId       String?
  /// EVIDENCE_DOCUMENT | POLICY | AUDIT | ACTION | RISK | INCIDENT | RCA | MISSED_CALL | TRAINING | CARE_PLAN
  sourceType     String
  sourceId       String
  /// A label kept from when the link was made, used only if the source can no longer be read.
  sourceRef      String?
  /// SUGGESTED | AWAITING_REVIEW | VERIFIED | REJECTED | OUTDATED | SUPERSEDED (separate from malware scanning).
  status         String       @default("SUGGESTED")
  /// DISCOVERED (suggested by the system) | MANUAL (linked by a person)
  origin         String
  note           String?
  /// A verified link stops counting after this date (the source's own expiry, or a year after verification).
  validUntil     DateTime?
  linkedById     String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, criterionId, sourceType, sourceId])
  @@index([organisationId, status])
  @@index([organisationId, sourceType, sourceId])
}

/// A dated copy of the readiness figures, for comparing over time. Never edited.
model CqcReadinessSnapshot {
  id              String         @id @default(cuid())
  organisationId  String
  assessmentId    String?
  assessment      CqcAssessment? @relation(fields: [assessmentId], references: [id])
  branchId        String?
  serviceTypeCode String?
  frameworkId     String
  method          String
  overall         Int?
  /// HIGH | LOW | NOT_ASSESSED
  confidence      String
  byQuestion      Json
  figures         Json
  reason          String
  takenById       String
  takenAt         DateTime       @default(now())

  @@index([organisationId, takenAt])
}

model RcaInvestigation {
  id               String             @id @default(cuid())
  organisationId   String
  /// RCA-2026-0001, unique in the organisation.
  reference        String
  title            String
  branchId         String?
  serviceUserId    String?
  category         String
  /// LOW | MODERATE | HIGH | CRITICAL
  severity         String
  eventDate        DateTime
  openedAt         DateTime           @default(now())
  /// The investigator.
  ownerId          String
  /// The responsible manager.
  managerId        String
  dueDate          DateTime           @db.Date
  /// NEW | INVESTIGATING | AWAITING_REVIEW | ACTIONS_IN_PROGRESS | EFFECTIVENESS_REVIEW | CLOSED
  status           String             @default("NEW")
  /// Safeguarding or otherwise confidential: details only for safeguarding-authorised people and the people on the case.
  restricted       Boolean            @default(false)
  summary          String?
  /// [{ at, text, kind: FACT | WITNESS | ASSUMPTION }]
  timeline         Json               @default("[]")
  peopleInvolved   String?
  immediateImpact  String?
  /// NONE | LOW | MODERATE | SEVERE | DEATH | POTENTIAL
  harm             String?
  immediateActions String?
  /// { [area]: { relevant: boolean, notes: string } }
  factors          Json               @default("{}")
  fiveWhys         Json               @default("[]")
  causeEffectNotes String?
  immediateCause   String?
  underlyingCauses String?
  uncertainties    String?
  conclusions      String?
  closureNote      String?
  closedAt         DateTime?
  closedById       String?
  closureException Boolean            @default(false)
  exceptionReason  String?
  reopenCount      Int                @default(0)
  lockVersion      Int                @default(1)
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sources          RcaSourceLink[]
  findings         RcaFinding[]
  reviews          RcaReview[]
  escalations      RcaEscalation[]
  actions          ComplianceAction[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, branchId])
  @@index([organisationId, dueDate])
}

/// The existing record an investigation looks into. The source keeps its own reference; nothing is copied or replaced.
model RcaSourceLink {
  id             String           @id @default(cuid())
  organisationId String
  rcaId          String
  rca            RcaInvestigation @relation(fields: [rcaId], references: [id], onDelete: Cascade)
  /// INCIDENT | MISSED_CALL | AUDIT_FINDING | RISK
  sourceType     String
  sourceId       String
  /// The source's own reference when linked (e.g. INC-2611-003).
  sourceRef      String
  /// A council, NHS or other external reference, kept as given.
  externalRef    String?
  addedById      String
  createdAt      DateTime         @default(now())

  @@unique([rcaId, sourceType, sourceId])
  @@index([organisationId, sourceType, sourceId])
}

model RcaFinding {
  id             String             @id @default(cuid())
  organisationId String
  rcaId          String
  rca            RcaInvestigation   @relation(fields: [rcaId], references: [id], onDelete: Cascade)
  /// IMMEDIATE | CONTRIBUTING | SYSTEMIC
  kind           String
  factorArea     String?
  text           String
  /// The evidence that supports the finding, in the investigator's words.
  evidence       String
  /// PROPOSED | CONFIRMED | NOT_SUPPORTED. Only a manager review confirms a finding.
  status         String             @default("PROPOSED")
  createdById    String
  createdAt      DateTime           @default(now())
  confirmedById  String?
  confirmedAt    DateTime?
  actions        ComplianceAction[]
}

/// A manager review, effectiveness review, closure or reopening, with a copy of the investigation at that moment. Never edited.
model RcaReview {
  id             String           @id @default(cuid())
  organisationId String
  rcaId          String
  rca            RcaInvestigation @relation(fields: [rcaId], references: [id], onDelete: Cascade)
  /// SUBMISSION | MANAGER_REVIEW | EFFECTIVENESS | CLOSURE | REOPEN
  stage          String
  decision       String
  note           String
  checks         Json             @default("{}")
  snapshot       Json             @default("{}")
  reviewerId     String
  createdAt      DateTime         @default(now())

  @@index([rcaId, createdAt])
}

/// A manager's recorded decision on one escalation question (safeguarding referral, CQC notification...). The platform
/// never decides these or sends anything itself.
model RcaEscalation {
  id             String           @id @default(cuid())
  organisationId String
  rcaId          String
  rca            RcaInvestigation @relation(fields: [rcaId], references: [id], onDelete: Cascade)
  /// IMMEDIATE_SAFETY | SAFEGUARDING_REFERRAL | CQC_NOTIFICATION | DUTY_OF_CANDOUR | EXTERNAL_NOTIFICATION
  kind           String
  /// DONE | REQUIRED_PENDING | NOT_REQUIRED
  decision       String
  rationale      String
  externalRef    String?
  notifiedAt     DateTime?
  decidedById    String
  decidedAt      DateTime         @default(now())

  @@unique([rcaId, kind])
}

/**
 * Atomic per-organisation counter. Never decrement, including after deletion.
 */
model ServiceUserReferenceCounter {
  organisationId String @id
  nextNumber     Int    @default(1)
}

/**
 * External identifiers belong to an issuer and a specific client or package;
 * shared FRAMEWORK references are intentionally NOT globally unique.
 * Store only encrypted values and keyed fingerprints for exact lookup.
 */
model ServiceUserExternalReference {
  id                 String      @id @default(cuid())
  organisationId     String
  serviceUserId      String
  serviceUser        ServiceUser @relation(fields: [serviceUserId, organisationId], references: [id, organisationId], onDelete: Cascade)
  type               String
  issuer             String
  issuerKey          String
  valueCipher        String
  valueHash          String
  verified           Boolean     @default(false)
  verificationNote   String?
  sourceDocumentId   String?
  sourcePage         Int?
  createdById        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  verifiedById       String?
  verifiedAt         DateTime?
  /// The council system or label the number belongs to, as written (e.g. "Frameworki"). Display only.
  systemLabel        String?
  /// The original wording around the number in its source document, encrypted like the value.
  sourceQuoteCipher  String?
  /// ACTIVE | SUPERSEDED. A superseded row is kept for audit and never used for search or conflict checks.
  status             String      @default("ACTIVE")
  supersededAt       DateTime?
  supersededByUserId String?
  /// The corrected reference that replaced this one, when there is one.
  replacedById       String?
  supersedeReason    String?

  @@unique([organisationId, serviceUserId, type, issuerKey, valueHash])
  @@index([organisationId, type, valueHash])
  @@index([organisationId, serviceUserId])
}

// ───────────────────────────── Branch-specific policy generation ─────────────────────────────

enum GeoLevel {
  NATIONAL
  REGIONAL
  LOCAL
}

enum PolicyScopeMode {
  NATIONAL
  SHARED_WITH_APPENDICES
  BRANCH_SPECIFIC
}

/// A local authority in England. Public reference data shared by every organisation; administrators may add more.
model LocalAuthority {
  code                  String   @id
  name                  String
  /// LONDON | NORTH_WEST | SOUTH_EAST | ... (see src/server/policy-geo/regions.ts)
  regionCode            String
  /// A sub-regional grouping such as "Merseyside", where arrangements are shared across neighbouring councils.
  subRegion             String?
  addedByOrganisationId String?
  createdAt             DateTime @default(now())

  branchProfiles BranchPolicyProfile[]
}

/// A branch's policy compliance profile. Reuses the Branch for name, address and service types.
model BranchPolicyProfile {
  branchId                        String          @id
  branch                          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organisationId                  String
  branchReference                 String?
  postcode                        String?
  localAuthorityCode              String?
  localAuthority                  LocalAuthority? @relation(fields: [localAuthorityCode], references: [code])
  regionCode                      String?
  safeguardingAdultsBoard         String?
  safeguardingChildrenPartnership String?
  regionalGuidance                String?
  /// How staff raise a safeguarding concern locally, as confirmed by the responsible manager from the official source.
  localProcedures                 String?
  referralUrl                     String?
  safeguardingContacts            String?
  outOfHoursContacts              String?
  integratedCareBoard             String?
  commissioningArrangements       String?
  /// Extra RegulatorySource ids that apply to this branch beyond its geography.
  extraSourceIds                  String[]        @default([])
  contactsVerifiedAt              DateTime?
  contactsVerifiedById            String?
  lastVerifiedAt                  DateTime?
  lastVerifiedById                String?
  nextReviewDate                  DateTime?       @db.Date
  responsibleManagerId            String?
  version                         Int             @default(1)
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  @@index([organisationId])
}

/// One organisation's check of a source: verified, unverified or needs review, with dates. History is in the audit log.
model OrgSourceReview {
  id                  String             @id @default(cuid())
  organisationId      String
  sourceId            String
  source              RegulatorySource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status              VerificationStatus @default(UNVERIFIED)
  lastCheckedAt       DateTime?
  nextReviewDate      DateTime?          @db.Date
  reviewerId          String?
  note                String?
  /// The source's content hash when it was verified. A later detected change sets the review back to NEEDS_REVIEW.
  verifiedContentHash String?
  updatedAt           DateTime           @updatedAt
  createdAt           DateTime           @default(now())

  @@unique([organisationId, sourceId])
  @@index([sourceId])
}

/// Which branches a policy applies to and, for a shared policy, the key of each branch's appendix section.
model PolicyBranchScope {
  id             String   @id @default(cuid())
  organisationId String
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appendixKey    String?
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([policyId, branchId])
  @@index([organisationId, branchId])
}

/// A source a policy relies on, for the whole policy (branchKey "") or for one branch's appendix.
model PolicySourceLink {
  id             String           @id @default(cuid())
  organisationId String
  policyId       String
  policy         Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sourceId       String
  source         RegulatorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  branchKey      String           @default("")
  createdById    String
  createdAt      DateTime         @default(now())

  @@unique([policyId, sourceId, branchKey])
  @@index([organisationId, sourceId])
}

/// One run of the Policy Generator: what was asked for, the sources assembled (a snapshot) and how the draft was made.
model PolicyGenerationRun {
  id             String            @id @default(cuid())
  organisationId String
  policyId       String
  policy         Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  revisionId     String?           @unique
  mode           PolicyScopeMode
  branchIds      String[]
  /// TEMPLATE | POLICY | NEW
  basis          String
  basisPolicyId  String?
  /// AI | SIMULATED_AI | SOURCE_GUIDED (no AI)
  method         String
  provider       String?
  sourceSnapshot Json
  createdById    String
  createdAt      DateTime          @default(now())
  gaps           PolicySourceGap[]

  @@index([organisationId, policyId])
}

/// Something the generator could not fill from verified material. Critical gaps block publication until resolved.
model PolicySourceGap {
  id             String              @id @default(cuid())
  organisationId String
  runId          String
  run            PolicyGenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  policyId       String
  branchId       String?
  sourceId       String?
  /// MISSING_SOURCE | UNVERIFIED_SOURCE | OUTDATED_SOURCE | SOURCE_CHECK_FAILED | MISSING_PROCEDURE | MISSING_CONTACTS | PROFILE_UNVERIFIED
  kind           String
  /// CRITICAL | WARNING
  severity       String
  message        String
  resolvedAt     DateTime?
  resolvedById   String?
  resolution     String?
  createdAt      DateTime            @default(now())

  @@index([organisationId, policyId])
}

/// A manager's record of which authority leads safeguarding for a person (or one incident), with the reasoning.
/// Append-only: a new decision supersedes the previous one; none is ever edited.
model SafeguardingAuthorityDecision {
  id                             String      @id @default(cuid())
  organisationId                 String
  serviceUserId                  String
  serviceUser                    ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  incidentId                     String?
  safeguardingLocalAuthorityCode String
  reasoning                      String
  /// The geography at the time: branch, residence, care location, funding authority, incident location.
  snapshot                       Json
  decidedById                    String
  decidedAt                      DateTime    @default(now())

  @@index([organisationId, serviceUserId])
}

// ───────────────────────────── Service user Call Notes ─────────────────────────────
// src/server/care/call-notes.ts. A record of a conversation, email or meeting about one person. Call Notes hold only
// general communication: anything that belongs in a structured record (care plan, risk, medication, rota, incident,
// contacts, personal details, documents) is sent to that record's own review queue and only linked from here.
// Notes are never deleted: a correction keeps the previous text as a CallNoteRevision, and a note can be superseded.

/// One Call Note. originalText is what the person typed or the source quote, and is never changed after saving.
/// method: TELEPHONE | FACE_TO_FACE | EMAIL | MEETING | VIDEO | OTHER
/// origin: MANUAL | AI_ASSISTED | BASIC_ORGANISER | INTAKE
/// status: DRAFT | AWAITING_REVIEW | APPROVED | CLARIFICATION_REQUESTED | REJECTED | SUPERSEDED | WITHDRAWN
model CallNote {
  id                String               @id @default(cuid())
  organisationId    String
  serviceUserId     String
  serviceUser       ServiceUser          @relation(fields: [serviceUserId, organisationId], references: [id, organisationId], onDelete: Restrict)
  /// CALL-2026-000001: from CallNoteReferenceCounter, never reused.
  reference         String
  /// The form's one-time key, so a repeated or retried submission returns the same note instead of a second one.
  submissionKey     String
  communicationAt   DateTime
  method            String
  contactName       String
  contactRole       String?
  /// The contact on record this conversation was with, when known.
  contactId         String?
  summary           String
  details           String?
  originalText      String
  clarification     String?
  /// A Council or Other Document this note relates to (for example the email it was copied from).
  sourceDocumentId  String?
  /// Where the information came from, for intake notes: "CI-0003 · Discharge letter, page 2".
  sourceLabel       String?
  intakeId          String?
  intakeFactId      String?               @unique
  /// Restricted notes (safeguarding, or marked so) open only for their author and people with serviceUser.sensitive.
  restricted        Boolean              @default(false)
  origin            String               @default("MANUAL")
  /// The AI provider name, "basic-organiser" (no AI) or null for a note typed without organising.
  reader            String?
  /// What the organiser proposed, exactly as produced, kept so human edits can be compared with it.
  proposal          Json?
  status            String               @default("DRAFT")
  /// SAFEGUARDING | MEDICATION | SAFETY: urgent concerns the note raised. Shown prominently, never hidden in the text.
  urgentKinds       String[]             @default([])
  escalatedAt       DateTime?
  escalationNote    String?
  escalationById    String?
  version           Int                  @default(1)
  supersededById    String?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  lockVersion       Int                  @default(1)
  items             CallNoteItem[]
  revisions         CallNoteRevision[]
  links             CallNoteLink[]
  tasks             CallNoteTask[]

  @@unique([organisationId, reference])
  @@unique([organisationId, submissionKey])
  @@index([organisationId, serviceUserId, communicationAt])
  @@index([organisationId, status])
}

/// One piece of information in a note, how it was classified, where it belongs and what was decided.
/// kind: CONFIRMED_FACT | THIRD_PARTY_REPORT | UNVERIFIED | PREFERENCE_REQUEST | PROFESSIONAL_ADVICE | AUTHORISED_INSTRUCTION
/// destination: CALL_NOTE | CARE_PLAN | RISK | MEDICATION | ROTA | VISIT | INCIDENT | SAFEGUARDING | CONTACTS | PERSONAL | DOCUMENTS
/// duplicate: NEW | EXACT | POSSIBLE | UPDATE | CONFLICT
/// decision: KEEP (stays in the note) | ROUTE (sent to its destination's review queue) | LINK (linked to an existing record) | LEAVE_OUT
model CallNoteItem {
  id               String   @id @default(cuid())
  organisationId   String
  callNoteId       String
  callNote         CallNote @relation(fields: [callNoteId], references: [id], onDelete: Cascade)
  position         Int
  text             String
  kind             String
  destination      String
  /// The exact words in the original text this item came from; quoteFound is false when they are not there.
  quote            String?
  quoteFound       Boolean  @default(true)
  urgent           Boolean  @default(false)
  /// AI | BASIC | MANUAL: what produced the item. aiKind / aiDestination keep what the organiser proposed.
  origin           String   @default("MANUAL")
  aiKind           String?
  aiDestination    String?
  duplicate        String   @default("NEW")
  /// "RiskAssessment:<id>" and so on: the existing record the duplicate check matched.
  duplicateRef     String?
  duplicateLabel   String?
  decision         String   @default("KEEP")
  /// The Care Coordinator review item a routed item became, once the note was approved.
  reviewItemId     String?
  createdAt        DateTime @default(now())

  @@index([callNoteId, position])
}

/// The previous content of a note each time it is corrected. Append-only (database trigger).
model CallNoteRevision {
  id         String   @id @default(cuid())
  callNoteId String
  callNote   CallNote @relation(fields: [callNoteId], references: [id], onDelete: Restrict)
  version    Int
  snapshot   Json
  reason     String
  createdById String
  createdAt  DateTime @default(now())

  @@unique([callNoteId, version])
}

/// A record the note is linked to. Shown only when the viewer may open the destination.
/// targetType: CARE_PLAN | RISK | VISIT | INCIDENT | REVIEW_ITEM | CONTACT | DOCUMENT | INTAKE | CALL_NOTE | MEDICATION
model CallNoteLink {
  id             String   @id @default(cuid())
  organisationId String
  callNoteId     String
  callNote       CallNote @relation(fields: [callNoteId], references: [id], onDelete: Cascade)
  targetType     String
  targetId       String
  label          String
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([callNoteId, targetType, targetId])
}

/// A follow-up action from a note, assigned to one person. Listed in Active Reminders and the assignee's
/// notifications, reminded when overdue, and closed only by the assignee or a manager with a completion note.
/// priority: LOW | MEDIUM | HIGH | URGENT. status: OPEN | DONE | CANCELLED
model CallNoteTask {
  id                 String    @id @default(cuid())
  organisationId     String
  serviceUserId      String
  callNoteId         String
  callNote           CallNote  @relation(fields: [callNoteId], references: [id], onDelete: Restrict)
  description        String
  assigneeId         String
  priority           String    @default("MEDIUM")
  dueOn              DateTime  @db.Date
  status             String    @default("OPEN")
  evidenceRequired   Boolean   @default(false)
  evidenceDocumentId String?
  completionNote     String?
  createdById        String
  createdAt          DateTime  @default(now())
  closedById         String?
  closedAt           DateTime?
  version            Int       @default(1)

  @@index([organisationId, status, dueOn])
  @@index([callNoteId])
  @@index([assigneeId, status])
}

/// Atomic per-organisation, per-year counter for Call Note references. Never decremented.
model CallNoteReferenceCounter {
  organisationId String
  year           Int
  nextNumber     Int    @default(1)

  @@id([organisationId, year])
}

/// A person's own marker on a policy, from the Policy Reader: IMPORTANT (pinned for quick access) or READING_LIST
/// (saved to read later). Personal and private to the person; it is never an assignment or an acknowledgement, which
/// stay in PolicyAssignmentRule and Acknowledgement.
model PolicyBookmark {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  policyId       String
  kind           String // IMPORTANT | READING_LIST
  createdAt      DateTime @default(now())

  @@unique([userId, policyId, kind])
  @@index([organisationId, userId, kind])
}

/// An explicit link from a policy or procedure to a form, template, checklist or tool it relies on (Forms PR 1).
/// Both ends belong to the same organisation, or both are CSB master documents (organisationId null); the database
/// enforces this. `sectionKey` places the link at one stable section of the policy, usually a procedure step such as
/// "procedure.reporting"; null means the whole document. A link is never edited or deleted by the app: it is withdrawn
/// (withdrawnAt) and a new one added, so the history stays. origin: BACKFILL_RELATED_TEXT (from the resource's
/// "Related policies" section), TEMPLATE (copied from the CSB master link when a template was adopted) or MANUAL.
model PolicyResourceLink {
  id             String    @id @default(cuid())
  organisationId String?
  policyId       String
  policy         Policy    @relation("PolicyResourceLinks", fields: [policyId], references: [id], onDelete: Cascade)
  resourceId     String
  resource       Policy    @relation("ResourceLinkedFrom", fields: [resourceId], references: [id], onDelete: Cascade)
  sectionKey     String?
  useWhen        String?
  required       Boolean   @default(false)
  sortOrder      Int       @default(0)
  origin         String
  createdById    String?
  createdAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  withdrawnById  String?
  withdrawReason String?

  @@index([policyId])
  @@index([resourceId])
  @@index([organisationId])
}

/// A form staff fill in on screen (Forms PR 2). CSB master definitions have organisationId null and are used by every
/// organisation; an organisation never edits them. `ref` matches the downloadable CSB document (e.g. CSB-FRM-020).
/// completeRoles / reviewRoles say who may fill it in and who reviews and sees every completed copy.
model FormDefinition {
  id               String        @id @default(cuid())
  organisationId   String?
  ref              String
  title            String
  description      String
  categoryCode     String
  sensitivity      String        @default("CONFIDENTIAL") // CONFIDENTIAL | INTERNAL
  status           String        @default("ACTIVE") // ACTIVE | ARCHIVED
  completeRoles    OrgRole[]
  reviewRoles      OrgRole[]
  subjectType      String? // SELF: the record is about the person filling it in
  /// CRM records a copy of this form may be linked to: SERVICE_USER, STAFF_MEMBER (Forms PR 4).
  linkTypes        String[]      @default([])
  currentVersionId String?       @unique
  currentVersion   FormVersion?  @relation("CurrentFormVersion", fields: [currentVersionId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  versions         FormVersion[] @relation("FormVersions")
  records          FormRecord[]

  @@index([organisationId])
}

/// An immutable published version of a form's fields. A record always keeps the version it was started on.
model FormVersion {
  id            String          @id @default(cuid())
  definitionId  String
  definition    FormDefinition  @relation("FormVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  versionNumber Int
  schemaJson    Json
  instructions  String
  changeSummary String
  contentHash   String
  status        String          @default("PUBLISHED") // PUBLISHED | SUPERSEDED
  createdById   String?
  publishedAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  currentOf     FormDefinition? @relation("CurrentFormVersion")
  records       FormRecord[]

  @@unique([definitionId, versionNumber])
}

/// One completed (or in-progress) copy of a form. Answers are keyed by the pinned version's stable field keys and are
/// frozen by the database once submitted, except while returned for correction.
model FormRecord {
  id             String            @id @default(cuid())
  organisationId String
  definitionId   String
  definition     FormDefinition    @relation(fields: [definitionId], references: [id])
  versionId      String
  version        FormVersion       @relation(fields: [versionId], references: [id])
  reference      String
  status         String            @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | APPROVED | VOIDED
  answers        Json              @default("{}")
  subjectType    String?
  subjectId      String?
  createdById    String
  reviewerId     String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  returnReason   String?
  voidReason     String?
  lockVersion    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         FormRecordEvent[]
  links          FormRecordLink[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([createdById])
}

/// Append-only history of a form record.
model FormRecordEvent {
  id             String     @id @default(cuid())
  organisationId String
  recordId       String
  record         FormRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type           String // CREATED | SAVED | SUBMITTED | RETURNED | RESUBMITTED | APPROVED | VOIDED | PRINTED | LINKED | UNLINKED
  actorId        String
  note           String?
  data           Json?
  createdAt      DateTime   @default(now())

  @@index([recordId])
}

/// Links a form record to the CRM record it is about (Forms PR 4). The person's details stay in their own record:
/// the link holds only ids. Removing a link keeps the row, marked removed with who, when and why.
model FormRecordLink {
  id             String        @id @default(cuid())
  organisationId String
  recordId       String
  record         FormRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  entityType     String // SERVICE_USER | STAFF_MEMBER
  serviceUserId  String?
  serviceUser    ServiceUser?  @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  staffMemberId  String?
  staffMember    StaffMember?  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime      @default(now())
  removedAt      DateTime?
  removedById    String?
  removeReason   String?

  @@index([recordId])
  @@index([serviceUserId])
  @@index([staffMemberId])
}

/// Post-hospital discharge review (AI CSB Coordinator, phase 7): one per discharge document read by the Care
/// Coordinator, linked to its source. A checklist the office works through; it never replaces the council support
/// plan and never authorises medication. status: OPEN | COMPLETED
model DischargeReview {
  id               String      @id @default(cuid())
  organisationId   String
  serviceUserId    String
  serviceUser      ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  intakeId         String?
  intakeDocumentId String?     @unique
  /// The filed ServiceUserDocument (the original letter, unchanged).
  documentId       String?
  documentName     String
  dischargeDate    DateTime?   @db.Date
  urgent           Boolean     @default(false)
  urgentReasons    String[]    @default([])
  /// [{ key, label, finding, outcome: null | NO_CHANGE | UPDATED | ACTION, note, by, at }]
  checks           Json
  status           String      @default("OPEN")
  createdById      String
  createdAt        DateTime    @default(now())
  completedById    String?
  completedAt      DateTime?
  outcome          String?
  lockVersion      Int         @default(1)

  @@index([organisationId, serviceUserId, status])
}

/// A version of a repeating visit's carer instructions (notes and task list), kept on every change (phase 9).
/// Never edited (database trigger). Changes reach future visits only; completed visits keep what they had.
model CareInstructionVersion {
  id             String               @id @default(cuid())
  organisationId String
  serviceUserId  String
  templateId     String
  template       VisitTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version        Int
  notes          String?
  tasks          String[]             @default([])
  changeSummary  String
  effectiveFrom  DateTime             @db.Date
  createdById    String
  createdAt      DateTime             @default(now())
  acks           CareInstructionAck[]

  @@unique([templateId, version])
  @@index([organisationId, serviceUserId])
}

/// A carer's confirmation that they have read a changed version of the instructions. Never edited.
model CareInstructionAck {
  id             String                 @id @default(cuid())
  organisationId String
  versionId      String
  version        CareInstructionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  staffId        String
  userId         String
  at             DateTime               @default(now())

  @@unique([versionId, staffId])
}

// ── Evantix Platform Admin Centre (8 Nov 2026) ──────────────────────────────
// The Organisation id stays the tenant identity. These tables describe each organisation as a SaaS customer of
// Evantix: its commercial profile, subscription history, licensed modules, AI usage metadata and support access.
// None of them holds care content.

enum CustomerStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

/// The organisation as an Evantix customer. Suspending or closing a customer never deletes its records.
model CustomerAccount {
  organisationId  String         @id
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Permanent customer reference, e.g. EVX-0001. Never reused.
  reference       String         @unique
  status          CustomerStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  legalName       String
  tradingName     String?
  companyNumber   String?
  address         String?
  contactEmail    String?
  contactPhone    String?
  country         String         @default("England")
  mainContactName String?
  serviceTypes    String[]       @default([])
  /// As given by the customer. Not proof of registration: cqcCheckedAt is only set when someone has checked it.
  cqcProviderId   String?
  cqcLocationIds  String[]       @default([])
  cqcCheckedAt    DateTime?
  cqcCheckedById  String?
  /// Idempotency key of the onboarding form that created this customer, so a retried submission never duplicates it.
  onboardingKey   String?        @unique
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

/// A configurable plan. Prices are optional: a plan without a price is shown as "price not set", never invented.
model SubscriptionPlan {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  name               String
  description        String?
  currency           String                 @default("GBP")
  monthlyPricePence  Int?
  annualPricePence   Int?
  includedUsers      Int?
  includedBranches   Int?
  storageMb          Int?
  aiRequestsPerMonth Int?
  modules            String[]               @default([])
  supportLevel       String?
  addOns             String[]               @default([])
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  subscriptions      CustomerSubscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// One row per subscription period. A change ends the current row (isCurrent false, endedAt set) and starts a new one,
/// so the history of entitlements and their effective dates is kept in full.
model CustomerSubscription {
  id                 String             @id @default(cuid())
  organisationId     String
  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  billingPeriod      BillingPeriod      @default(MONTHLY)
  isCurrent          Boolean            @default(true)
  startsAt           DateTime           @default(now())
  trialEndsAt        DateTime?
  renewsAt           DateTime?
  endedAt            DateTime?
  userAllowance      Int?
  branchAllowance    Int?
  storageMb          Int?
  aiRequestsPerMonth Int?
  /// The billing provider's own reference, once a provider is connected.
  providerRef        String?
  changeReason       String?
  createdById        String?
  createdAt          DateTime           @default(now())

  @@index([organisationId, createdAt])
  @@index([isCurrent, status])
}

/// Whether an organisation is licensed for a module. No row means the module is on (every existing customer keeps
/// what it has today). Disabling a module never deletes its records.
model TenantModuleEntitlement {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  moduleKey      String
  enabled        Boolean      @default(true)
  /// Module limits, e.g. AI_COORDINATOR: { monthlyRequests, monthlySpendPence }.
  limits         Json         @default("{}")
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organisationId, moduleKey])
}

/// Metadata of one AI request: never the prompt, the document or the answer.
model AiUsageEvent {
  id             String   @id @default(cuid())
  organisationId String?
  feature        String
  provider       String
  model          String?
  success        Boolean
  errorReason    String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([createdAt])
}

/// Platform-wide settings, each with a documented effect (src/server/platform/settings.ts). Never holds secrets:
/// API keys and passwords stay in the hosting environment.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum SupportAccessStatus {
  REQUESTED
  ACTIVE
  DECLINED
  REVOKED
}

/// Time-limited, purpose-bound access for Evantix support to a customer's configuration and activity log. Never
/// impersonation and never service-user records.
model SupportAccessGrant {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedById  String
  purpose        String
  scopes         String[]
  durationHours  Int
  /// CUSTOMER (approved by one of the customer's administrators) or EMERGENCY (platform admin, reason recorded).
  authorisation  String              @default("CUSTOMER")
  status         SupportAccessStatus @default(REQUESTED)
  decidedById    String?
  decidedAt      DateTime?
  startsAt       DateTime?
  expiresAt      DateTime?
  revokedById    String?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime            @default(now())

  @@index([organisationId, status])
}
